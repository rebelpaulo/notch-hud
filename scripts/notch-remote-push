#!/bin/sh

config=${HOME:?}/.notch-hud/remote.json
[ -f "$config" ] || exit 0

jq_bin=${NOTCH_REMOTE_JQ:-jq}
curl_bin=${NOTCH_REMOTE_CURL:-curl}

url=$("$jq_bin" -er '.url | strings | select(length > 0)' "$config") || exit $?
secret=$("$jq_bin" -er '.secret | strings | select(length > 0)' "$config") || exit $?
url=${url%/}

curl_common() {
    "$curl_bin" -sS --fail-with-body --max-time 10 "$@"
}

case ${1:-} in
    --state)
        [ "$#" -eq 1 ] || exit 64
        curl_common \
            "$url/api/state" \
            -H "Authorization: Bearer $secret"
        ;;
    --ack-off)
        [ "$#" -eq 1 ] || exit 64
        curl_common \
            -X POST \
            "$url/api/state" \
            -H "Authorization: Bearer $secret" \
            -H 'Content-Type: application/json' \
            --data '{"keep_awake_enabled":true}'
        ;;
    --*)
        printf '%s\n' 'usage: notch-remote-push <title> <body> [tag] | --state | --ack-off' >&2
        exit 64
        ;;
    *)
        [ "$#" -eq 2 ] || [ "$#" -eq 3 ] || {
            printf '%s\n' 'usage: notch-remote-push <title> <body> [tag] | --state | --ack-off' >&2
            exit 64
        }
        if [ "$#" -eq 3 ]; then
            payload=$("$jq_bin" -cn \
                --arg title "$1" \
                --arg body "$2" \
                --arg tag "$3" \
                '{title:$title,body:$body,tag:$tag}') || exit $?
        else
            payload=$("$jq_bin" -cn \
                --arg title "$1" \
                --arg body "$2" \
                '{title:$title,body:$body}') || exit $?
        fi
        curl_common \
            -X POST \
            "$url/api/notify" \
            -H "Authorization: Bearer $secret" \
            -H 'Content-Type: application/json' \
            --data "$payload"
        ;;
esac
