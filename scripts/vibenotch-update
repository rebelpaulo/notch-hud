#!/bin/sh

# Downloads one signed Vibenotch release and runs its existing installer.
# The app passes only the GitHub release tag shown in the update card. Release
# assets are accepted only when their checksum manifest verifies against the
# public key embedded below.
#
# Env override (used by tests and non-standard app locations):
#   VIBENOTCH_UPDATE_INFO_PLIST  default
#       /Applications/Vibenotch.app/Contents/Info.plist

set -eu

tag=${1:-}
if ! printf '%s\n' "$tag" | /usr/bin/grep -Eq '^v[0-9]+\.[0-9]+\.[0-9]+$'; then
    printf '%s\n' "vibenotch-update: expected a release tag such as v0.4.0" >&2
    exit 64
fi

version=${tag#v}
installed_plist=${VIBENOTCH_UPDATE_INFO_PLIST:-/Applications/Vibenotch.app/Contents/Info.plist}

version_is_newer_than() {
    candidate_version=$1
    baseline_version=$2

    candidate_major=${candidate_version%%.*}
    candidate_tail=${candidate_version#*.}
    candidate_minor=${candidate_tail%%.*}
    candidate_patch=${candidate_tail#*.}

    baseline_major=${baseline_version%%.*}
    baseline_tail=${baseline_version#*.}
    baseline_minor=${baseline_tail%%.*}
    baseline_patch=${baseline_tail#*.}

    [ "$candidate_major" -gt "$baseline_major" ] && return 0
    [ "$candidate_major" -lt "$baseline_major" ] && return 1
    [ "$candidate_minor" -gt "$baseline_minor" ] && return 0
    [ "$candidate_minor" -lt "$baseline_minor" ] && return 1
    [ "$candidate_patch" -gt "$baseline_patch" ]
}

printf '%s\n' "Checking installed Vibenotch version..."
installed_version=
if [ -f "$installed_plist" ]; then
    installed_version=$(
        /usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' \
            "$installed_plist" 2>/dev/null || :
    )
fi

if printf '%s\n' "$installed_version" | \
    /usr/bin/grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$'
then
    if [ "$installed_version" = "$version" ]; then
        printf '%s\n' "Vibenotch $version is already installed. Nothing to do."
        exit 0
    fi
    if version_is_newer_than "$installed_version" "$version"; then
        printf '%s\n' \
            "Vibenotch $installed_version is newer than $version. Nothing to do."
        exit 0
    fi
    printf '%s\n' "Installed Vibenotch $installed_version; updating to $version."
else
    printf '%s\n' \
        "Could not determine the installed version; continuing with the verified update."
fi

[ -x /usr/bin/curl ] || {
    printf '%s\n' "vibenotch-update: curl is required" >&2
    exit 1
}
[ -x /usr/bin/tar ] || {
    printf '%s\n' "vibenotch-update: tar is required" >&2
    exit 1
}
[ -x /usr/bin/openssl ] || {
    printf '%s\n' "vibenotch-update: openssl is required" >&2
    exit 1
}
[ -x /usr/bin/shasum ] || {
    printf '%s\n' "vibenotch-update: shasum is required" >&2
    exit 1
}

work_dir=$(/usr/bin/mktemp -d "${TMPDIR:-/tmp}/vibenotch-update.XXXXXX") || exit 1
cleanup() {
    case $work_dir in
        */vibenotch-update.*) /bin/rm -rf -- "$work_dir" ;;
    esac
}
trap cleanup EXIT HUP INT TERM

archive_name=Vibenotch-$version.tar.gz
manifest_name=$archive_name.sha256
signature_name=$manifest_name.sig
archive=$work_dir/$archive_name
manifest=$work_dir/$manifest_name
signature=$work_dir/$signature_name
public_key=$work_dir/release-signing-public.pem
source_dir=$work_dir/notch-hud-$version
release_url=https://github.com/rebelpaulo/notch-hud/releases/download/$tag

printf '%s\n' "Downloading Vibenotch $version from GitHub..."
/usr/bin/curl --proto '=https' --tlsv1.2 -fsSL "$release_url/$archive_name" -o "$archive"
/usr/bin/curl --proto '=https' --tlsv1.2 -fsSL "$release_url/$manifest_name" -o "$manifest"
/usr/bin/curl --proto '=https' --tlsv1.2 -fsSL "$release_url/$signature_name" -o "$signature"

/bin/cat > "$public_key" <<'PUBLIC_KEY'
-----BEGIN PUBLIC KEY-----
MIIBojANBgkqhkiG9w0BAQEFAAOCAY8AMIIBigKCAYEArR5a3eza1A8DsVALag86
fg6EGzDPeicD0iO8km2sKPu1R9gGqidnRmaOGuYwqAwnN2ClVoYp0TdWFvwQCXio
E9z4H9fv17Fs+NQlVh/VTNWq+gIS66jj6QtZS/mvi+di/2C7KmxCRLluMLuTweL9
+INwxnhGeOe0PDw9/GEK7hvsj12O9sCaIU2aIsrsRYfaOAfLix6N+LLp+sYX6ggV
87yea25CE8ipGYkZPbBij94oOcJm3wVffMQxVMNr2YmSaw2q2bQm6LZt8tqFbx0D
GBmvQPKgTO8OGnEOOd53gRgr8YK7pWaP57te4PAKX/IoowT0URIP513uAMzBm94a
7evwdLGY5vbGDgoj1Ums6EUPkNOt7BvKO4bC2rcbh9skychDSGvTBxEtmXq+cJJu
iFuSd411bXOJT2yTaliTje8PzGb+OKU9TPq/AY5CijJsbJUUHvxTNiEByOAhclgl
gitOOwySFYKv2iW/2B2Q3KClk28E+V2armtxDU+NpSO/AgMBAAE=
-----END PUBLIC KEY-----
PUBLIC_KEY

if ! /usr/bin/openssl dgst -sha256 -verify "$public_key" \
    -signature "$signature" "$manifest" >/dev/null 2>&1; then
    printf '%s\n' "vibenotch-update: release signature verification failed" >&2
    exit 1
fi

line_count=$(/usr/bin/wc -l < "$manifest" | /usr/bin/tr -d ' ')
manifest_line=$(/usr/bin/sed -n '1p' "$manifest")
manifest_suffix="  $archive_name"
expected_hash=${manifest_line%"$manifest_suffix"}
if [ "$line_count" != 1 ] || [ "$manifest_line" != "$expected_hash$manifest_suffix" ] \
    || ! printf '%s\n' "$expected_hash" | /usr/bin/grep -Eq '^[0-9a-f]{64}$'; then
    printf '%s\n' "vibenotch-update: signed checksum manifest has an unexpected format" >&2
    exit 1
fi

actual_hash=$(/usr/bin/shasum -a 256 "$archive" | /usr/bin/awk '{ print $1 }')
if [ "$actual_hash" != "$expected_hash" ]; then
    printf '%s\n' "vibenotch-update: release checksum verification failed" >&2
    exit 1
fi

/usr/bin/tar -xzf "$archive" -C "$work_dir"

if [ ! -f "$source_dir/scripts/install.sh" ]; then
    printf '%s\n' "vibenotch-update: the release archive has an unexpected layout" >&2
    exit 1
fi

printf '%s\n' "Installing Vibenotch $version..."
/bin/sh "$source_dir/scripts/install.sh" --yes

printf '%s\n' "Vibenotch $version installed."
