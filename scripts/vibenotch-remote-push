#!/bin/sh

config=${HOME:?}/.vibenotch/remote.json
[ -f "$config" ] || exit 0

jq_bin=${VIBENOTCH_REMOTE_JQ:-jq}
curl_bin=${VIBENOTCH_REMOTE_CURL:-curl}

url=$("$jq_bin" -er '.url | strings | select(length > 0)' "$config") || exit $?
secret=$("$jq_bin" -er '.secret | strings | select(length > 0)' "$config") || exit $?
url=${url%/}

curl_common() {
    "$curl_bin" -sS --fail-with-body --max-time 10 "$@"
}

case ${1:-} in
    --state)
        [ "$#" -eq 1 ] || exit 64
        curl_common \
            "$url/api/state" \
            -H "Authorization: Bearer $secret"
        ;;
    --state-put)
        # Publishes the Mac's own on/off state so the phone shows the truth.
        [ "$#" -eq 1 ] || exit 64
        curl_common \
            -X POST \
            "$url/api/state" \
            -H "Authorization: Bearer $secret" \
            -H 'Content-Type: application/json' \
            --data-binary @-
        ;;
    --settings-put)
        [ "$#" -eq 1 ] || exit 64
        curl_common \
            -X POST \
            "$url/api/settings" \
            -H "Authorization: Bearer $secret" \
            -H 'Content-Type: application/json' \
            --data-binary @-
        ;;
    --*)
        printf '%s\n' 'usage: vibenotch-remote-push <title> <body> [tag] | --state | --state-put | --settings-put' >&2
        exit 64
        ;;
    *)
        # A 4th argument marks the push silent. Only the status strip uses it:
        # it replaces itself whenever anything moves, and a buzz per change
        # would get the app's notifications turned off entirely.
        silent=false
        if [ "$#" -eq 4 ] && [ "$4" = "--silent" ]; then
            silent=true
            set -- "$1" "$2" "$3"
        fi
        [ "$#" -eq 2 ] || [ "$#" -eq 3 ] || {
            printf '%s\n' 'usage: vibenotch-remote-push <title> <body> [tag] | --state | --state-put | --settings-put' >&2
            exit 64
        }
        if [ "$#" -eq 3 ]; then
            payload=$("$jq_bin" -cn \
                --arg title "$1" \
                --arg body "$2" \
                --arg tag "$3" \
                --argjson silent "$silent" \
                '{title:$title,body:$body,tag:$tag,silent:$silent}') || exit $?
        else
            payload=$("$jq_bin" -cn \
                --arg title "$1" \
                --arg body "$2" \
                '{title:$title,body:$body}') || exit $?
        fi
        curl_common \
            -X POST \
            "$url/api/notify" \
            -H "Authorization: Bearer $secret" \
            -H 'Content-Type: application/json' \
            --data "$payload"
        ;;
esac
