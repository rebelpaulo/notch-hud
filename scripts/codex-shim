#!/bin/sh

script_dir=$(CDPATH= cd -P "$(dirname "$0")" 2>/dev/null && pwd)
notch_home=${NOTCH_HUD_HOME:-"$HOME/.notch-hud"}
emitter=$script_dir/notch-emit
if [ ! -x "$emitter" ]; then
    emitter=$notch_home/bin/notch-emit
fi

shim_dir=$script_dir
default_bin=$HOME/.notch-hud/bin
resolved_default_bin=$(CDPATH= cd -P "$default_bin" 2>/dev/null && pwd)

real_codex=
remaining_path=$PATH:
while [ -n "$remaining_path" ]; do
    path_entry=${remaining_path%%:*}
    remaining_path=${remaining_path#*:}
    [ -n "$path_entry" ] || path_entry=.
    resolved_entry=$(CDPATH= cd -P "$path_entry" 2>/dev/null && pwd)
    if [ -n "$resolved_entry" ]; then
        if [ "$resolved_entry" != "$shim_dir" ] && \
           { [ -z "$resolved_default_bin" ] || [ "$resolved_entry" != "$resolved_default_bin" ]; } && \
           [ -x "$resolved_entry/codex" ] && [ ! -d "$resolved_entry/codex" ]
        then
            real_codex=$resolved_entry/codex
            break
        fi
    fi
done

if [ -z "$real_codex" ]; then
    printf '%s\n' 'notch-hud: real codex executable not found in PATH' >&2
    exit 127
fi

NOTCH_CODEX_SESSION_ID=codex-$$
export NOTCH_CODEX_SESSION_ID

project=$(basename "$PWD" 2>/dev/null)
if [ -x "$emitter" ]; then
    "$emitter" "$NOTCH_CODEX_SESSION_ID" codex working \
        --source codex --project "$project" --cwd "$PWD" >/dev/null 2>&1 || :
fi

remove_session() {
    if [ -x "$emitter" ]; then
        "$emitter" "$NOTCH_CODEX_SESSION_ID" codex done --source codex --remove \
            >/dev/null 2>&1 || :
    fi
}
trap remove_session 0

"$real_codex" "$@"
codex_status=$?
exit "$codex_status"
