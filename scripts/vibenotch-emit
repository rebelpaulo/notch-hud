#!/bin/sh

if [ "$#" -lt 3 ]; then
    exit 0
fi

id=$1
agent=$2
status=$3
shift 3

detail=
project=
cwd=
pid=
task=
prompt=
tool_line=
model=
source=
detail_set=0
project_set=0
cwd_set=0
pid_set=0
task_set=0
prompt_set=0
tool_line_set=0
model_set=0
source_set=0
remove=0

while [ "$#" -gt 0 ]; do
    case $1 in
        --detail)
            [ "$#" -ge 2 ] || exit 0
            detail=$2
            detail_set=1
            shift 2
            ;;
        --project)
            [ "$#" -ge 2 ] || exit 0
            project=$2
            project_set=1
            shift 2
            ;;
        --cwd)
            [ "$#" -ge 2 ] || exit 0
            cwd=$2
            cwd_set=1
            shift 2
            ;;
        --pid)
            [ "$#" -ge 2 ] || exit 0
            pid=$2
            pid_set=1
            shift 2
            ;;
        --task)
            [ "$#" -ge 2 ] || exit 0
            task=$2
            task_set=1
            shift 2
            ;;
        --prompt)
            [ "$#" -ge 2 ] || exit 0
            prompt=$2
            prompt_set=1
            shift 2
            ;;
        --tool-line)
            [ "$#" -ge 2 ] || exit 0
            tool_line=$2
            tool_line_set=1
            shift 2
            ;;
        --model)
            [ "$#" -ge 2 ] || exit 0
            model=$2
            model_set=1
            shift 2
            ;;
        --source)
            [ "$#" -ge 2 ] || exit 0
            source=$2
            source_set=1
            shift 2
            ;;
        --remove)
            remove=1
            shift
            ;;
        *)
            shift
            ;;
    esac
done

case $id in
    ""|*/*)
        exit 0
        ;;
esac

notch_home=${VIBENOTCH_HOME:-"$HOME/.vibenotch"}
spool_dir=$notch_home/sessions
seq_dir=$notch_home/seq
session_file=$spool_dir/$id.json
seq_file=$seq_dir/$id

mkdir -p "$spool_dir" "$seq_dir" >/dev/null 2>&1 || exit 0

if [ "$remove" -eq 1 ]; then
    rm -f "$session_file" "$seq_file" >/dev/null 2>&1
    exit 0
fi

command -v jq >/dev/null 2>&1 || exit 0

seq=0
if [ -f "$seq_file" ]; then
    seq=$(sed -n '1p' "$seq_file" 2>/dev/null)
fi
case $seq in
    ""|*[!0-9]*) seq=0 ;;
esac
seq=$((seq + 1))
printf '%s\n' "$seq" > "$seq_file" 2>/dev/null || exit 0

case $pid in
    ""|*[!0-9]*) pid_json=null ;;
    *) pid_json=$pid ;;
esac

# Find the controlling tty by walking up the ppid chain.
find_tty() {
    pid=$$
    i=0
    while [ "$pid" -gt 1 ] && [ "$i" -lt 25 ]; do
        t=$(ps -o tty= -p "$pid" 2>/dev/null | tr -d ' ')
        case "$t" in
            ttys*) printf '/dev/%s\n' "$t"; return 0 ;;
        esac
        pid=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')
        [ -z "$pid" ] && break
        i=$((i+1))
    done
    return 0
}

# VIBENOTCH_TTY (set, possibly empty) overrides detection — tests need a
# deterministic ttyless run; the ppid walk sees the test terminal's tty.
if [ -n "${VIBENOTCH_TTY+x}" ]; then
    terminal_tty=$VIBENOTCH_TTY
else
    terminal_tty=$(find_tty)
fi

if [ "$source_set" -eq 0 ]; then
    source=vibenotch-emit
    if [ -z "$terminal_tty" ]; then
        case $agent in
            claude*)
                # ponytail: user-approved simplification — every ttyless Claude
                # session is classified as the desktop app (an /Applications/
                # Claude.app ppid-walk was verified to work but adds ~50 ps
                # spawns per emit and makes tests environment-dependent; wire
                # real detection here if headless claude jobs must stay
                # background).
                source=claude-desktop
                ;;
        esac
    fi
fi

updated=$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null)
tmp_file=$spool_dir/$id.json.tmp.$$
old_payload={}
if [ -f "$session_file" ]; then
    candidate=$(jq -c 'if type == "object" then . else {} end' "$session_file" 2>/dev/null)
    if [ -n "$candidate" ]; then
        old_payload=$candidate
    fi
fi

if jq -n \
    --argjson old "$old_payload" \
    --arg id "$id" \
    --arg agent "$agent" \
    --arg status "$status" \
    --arg detail "$detail" \
    --arg project "$project" \
    --arg cwd "$cwd" \
    --arg task "$task" \
    --arg prompt "$prompt" \
    --arg tool_line "$tool_line" \
    --arg model "$model" \
    --arg source "$source" \
    --arg updated "$updated" \
    --arg term_program "${TERM_PROGRAM:-}" \
    --arg tty "$terminal_tty" \
    --arg iterm_session_id "${ITERM_SESSION_ID:-}" \
    --arg wezterm_pane "${WEZTERM_PANE:-}" \
    --arg kitty_window_id "${KITTY_WINDOW_ID:-}" \
    --arg window_id "${WINDOWID:-}" \
    --argjson pid "$pid_json" \
    --argjson seq "$seq" \
    --argjson detail_set "$detail_set" \
    --argjson project_set "$project_set" \
    --argjson cwd_set "$cwd_set" \
    --argjson pid_set "$pid_set" \
    --argjson task_set "$task_set" \
    --argjson prompt_set "$prompt_set" \
    --argjson tool_line_set "$tool_line_set" \
    --argjson model_set "$model_set" \
    '$old + {
        schema: 1,
        id: $id,
        agent: $agent,
        status: $status,
        updated: $updated,
        started: ($old.started // $updated),
        seq: $seq,
        terminal: (($old.terminal // {}) + ({
            termProgram: (if $term_program == "" then null else $term_program end),
            tty: (if $tty == "" then null else $tty end),
            itermSessionId: (if $iterm_session_id == "" then null else $iterm_session_id end),
            weztermPane: (if $wezterm_pane == "" then null else $wezterm_pane end),
            kittyWindowId: (if $kitty_window_id == "" then null else $kitty_window_id end),
            windowId: (if $window_id == "" then null else $window_id end)
        } | with_entries(select(.value != null)))),
        source: $source
    }
    + (if $pid_set == 1 then {pid: $pid} else {} end)
    + (if $project_set == 1 then
        {project: (if $project == "" then null else $project end)}
      else {} end)
    + (if $cwd_set == 1 then
        {cwd: (if $cwd == "" then null else $cwd end)}
      else {} end)
    + (if $detail_set == 1 then
        {detail: (if $detail == "" then null else $detail end)}
      else {} end)
    + (if $task_set == 1 then
        {task: (if $task == "" then null else $task end)}
      else {} end)
    + (if $prompt_set == 1 then
        {prompt: (if $prompt == "" then null else $prompt end)}
      else {} end)
    + (if $tool_line_set == 1 then
        {toolLine: (if $tool_line == "" then null else $tool_line end)}
      else {} end)
    + (if $model_set == 1 then
        {model: (if $model == "" then null else $model end)}
      else {} end)' > "$tmp_file" 2>/dev/null
then
    mv -f "$tmp_file" "$session_file" >/dev/null 2>&1
else
    rm -f "$tmp_file" >/dev/null 2>&1
fi

exit 0
