#!/bin/sh

# This hook must never replace Claude's own permission UI unless it has a
# complete, explicit decision from Vibenotch.
exec 2>/dev/null
umask 077

pending_file=
decision_file=

remove_pending() {
    if [ -n "$pending_file" ]; then
        rm -f "$pending_file" >/dev/null 2>&1
    fi
}

remove_decision() {
    if [ -n "$decision_file" ]; then
        rm -f "$decision_file" >/dev/null 2>&1
    fi
}

abort_hook() {
    remove_pending
    remove_decision
    exit 0
}

trap 'abort_hook' HUP INT QUIT PIPE TERM

command -v jq >/dev/null 2>&1 || exit 0

payload=$(cat 2>/dev/null) || exit 0
[ -n "$payload" ] || exit 0
printf '%s' "$payload" | jq -e -s '
    length == 1 and
    (.[0] | type == "object") and
    (.[0].tool_name | type == "string") and
    (.[0].tool_input | type == "object") and
    (.[0].session_id | type == "string") and
    (.[0].permission_mode | type == "string") and
    (.[0].cwd == null or (.[0].cwd | type == "string"))
' >/dev/null 2>&1 || exit 0

notch_home=${VIBENOTCH_HOME:-"$HOME/.vibenotch"}
config_file=$notch_home/config.json
[ -f "$config_file" ] || exit 0
jq -e -s 'length == 1 and (.[0] | type == "object" and .approvals == true)' \
    "$config_file" >/dev/null 2>&1 || exit 0

# Find the controlling tty by walking up the ppid chain. This intentionally
# matches vibenotch-emit so launchd/background sessions are never gated.
find_tty() {
    pid=$$
    i=0
    while [ "$pid" -gt 1 ] && [ "$i" -lt 25 ]; do
        t=$(ps -o tty= -p "$pid" 2>/dev/null | tr -d ' ')
        case "$t" in
            ttys*) printf '/dev/%s\n' "$t"; return 0 ;;
        esac
        pid=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')
        [ -z "$pid" ] && break
        i=$((i+1))
    done
    return 0
}

terminal_tty=$(find_tty)
[ -n "$terminal_tty" ] || exit 0

tool_name=$(printf '%s' "$payload" | jq -r '.tool_name // empty' 2>/dev/null) || exit 0
session_id=$(printf '%s' "$payload" | jq -r '.session_id // empty' 2>/dev/null) || exit 0
cwd=$(printf '%s' "$payload" | jq -r '.cwd // empty' 2>/dev/null) || exit 0
permission_mode=$(printf '%s' "$payload" | jq -r '.permission_mode // empty' 2>/dev/null) || exit 0

[ "$permission_mode" = default ] || exit 0
case $tool_name in
    Edit|Write|NotebookEdit|Bash) ;;
    *) exit 0 ;;
esac
case $session_id in
    ""|.|..|*/*) exit 0 ;;
esac

command_value=
tool_class=$tool_name
if [ "$tool_name" = Bash ]; then
    command_value=$(printf '%s' "$payload" | jq -r '.tool_input.command // empty' 2>/dev/null) || exit 0
    first_word=$(printf '%s\n' "$command_value" | awk 'NF { print $1; exit }') || exit 0
    tool_class=Bash:$first_word
fi

session_allow_dir=$notch_home/session-allow
session_allow_file=$session_allow_dir/$session_id
if [ -f "$session_allow_file" ]; then
    grep -F -x -q -- "$tool_class" "$session_allow_file" 2>/dev/null
    grep_status=$?
    case $grep_status in
        0)
            printf '%s\n' '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"allow","permissionDecisionReason":"Vibenotch bypass"}}'
            exit 0
            ;;
        1) ;;
        *) exit 0 ;;
    esac
fi

command_begins_with() {
    prefix=$1
    [ -n "$prefix" ] || return 1
    case $command_value in
        "$prefix"*) return 0 ;;
        *) return 1 ;;
    esac
}

allow_entry_matches() {
    entry=$1

    if [ "$entry" = "$tool_name" ]; then
        return 0
    fi
    [ "$tool_name" = Bash ] || return 1

    case $entry in
        Bash\(*:\*\))
            prefix=${entry#Bash(}
            prefix=${prefix%:\*)}
            [ "$entry" = "Bash($prefix:*)" ] || return 1
            command_begins_with "$prefix"
            return $?
            ;;
        Bash\(*\ \*\))
            prefix=${entry#Bash(}
            prefix=${prefix% \*)}
            [ "$entry" = "Bash($prefix *)" ] || return 1
            command_begins_with "$prefix"
            return $?
            ;;
    esac

    return 1
}

settings_match=false
check_settings_file() {
    settings_file=$1
    [ -f "$settings_file" ] || return 0

    jq -e -s 'length == 1 and (.[0] | type == "object" and ((.permissions? // {}) | type == "object") and ((.permissions.allow? // []) | type == "array"))' \
        "$settings_file" >/dev/null 2>&1 || return 2

    entries=$(jq -r -s '.[0].permissions.allow? // [] | .[] | select(type == "string")' "$settings_file" 2>/dev/null) || return 2
    while IFS= read -r entry; do
        if allow_entry_matches "$entry"; then
            settings_match=true
            return 0
        fi
    done <<EOF
$entries
EOF
    return 0
}

check_settings_file "$HOME/.claude/settings.json"
[ "$?" -ne 2 ] || exit 0

if [ "$settings_match" != true ] && [ -n "${CLAUDE_PROJECT_DIR:-}" ]; then
    check_settings_file "$CLAUDE_PROJECT_DIR/.claude/settings.json"
    [ "$?" -ne 2 ] || exit 0
fi
if [ "$settings_match" != true ] && [ -n "${CLAUDE_PROJECT_DIR:-}" ]; then
    check_settings_file "$CLAUDE_PROJECT_DIR/.claude/settings.local.json"
    [ "$?" -ne 2 ] || exit 0
fi
[ "$settings_match" = true ] && exit 0

pending_dir=$notch_home/pending
decisions_dir=$notch_home/decisions
mkdir -p "$pending_dir" "$decisions_dir" "$session_allow_dir" >/dev/null 2>&1 || exit 0
chmod 700 "$pending_dir" "$decisions_dir" "$session_allow_dir" >/dev/null 2>&1 || exit 0

pending_file=$pending_dir/$session_id.json
decision_file=$decisions_dir/$session_id.json
pending_tmp=$pending_file.tmp.$$
rm -f "$decision_file" >/dev/null 2>&1 || exit 0

created=$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null) || exit 0

if ! printf '%s' "$payload" | jq \
    --arg tool "$tool_name" \
    --arg session_id "$session_id" \
    --arg cwd "$cwd" \
    --arg created "$created" \
    '
    def capped: .[0:4000];
    def path: (.tool_input.file_path // .tool_input.notebook_path // "");
    {
        schema: 1,
        sessionId: $session_id,
        tool: $tool,
        cwd: $cwd,
        created: $created,
        summary: (
            if $tool == "Bash" then "Bash " + ((.tool_input.command // "") | gsub("[\\r\\n]+"; " ") | capped)
            elif $tool == "Write" then "Write " + path
            else "Edit " + path
            end
        ),
        bash: (
            if $tool == "Bash" then {command: ((.tool_input.command // "") | capped)}
            else null
            end
        ),
        edit: (
            if $tool == "Edit" or $tool == "NotebookEdit" then {
                file: path,
                old: ((.tool_input.old_string // "") | capped),
                new: ((.tool_input.new_string // .tool_input.new_source // "") | capped)
            }
            else null
            end
        ),
        write: (
            if $tool == "Write" then {
                file: path,
                content: ((.tool_input.content // "") | capped)
            }
            else null
            end
        )
    }
    ' > "$pending_tmp" 2>/dev/null
then
    rm -f "$pending_tmp" >/dev/null 2>&1
    exit 0
fi

mv -f "$pending_tmp" "$pending_file" >/dev/null 2>&1 || {
    rm -f "$pending_tmp" >/dev/null 2>&1
    exit 0
}

# 80 checks separated by 79 quarter-second sleeps preserve the hard 20-second
# upper bound while still checking once at roughly 19.75 seconds.
poll_count=0
while [ "$poll_count" -lt 80 ]; do
    if [ -f "$decision_file" ]; then
        decision_payload=$(jq -c -e -s '
            if length == 1
                and (.[0] | type == "object")
                and (.[0].decision | type == "string")
                and (.[0].scope | type == "string")
            then .[0]
            else error("invalid decision")
            end
        ' "$decision_file" 2>/dev/null) || {
            remove_decision
            abort_hook
        }
        decision=$(printf '%s' "$decision_payload" | jq -r '.decision' 2>/dev/null) || abort_hook
        scope=$(printf '%s' "$decision_payload" | jq -r '.scope' 2>/dev/null) || abort_hook

        case $decision:$scope in
            allow:once|allow:session|deny:once|deny:session) ;;
            *)
                remove_decision
                abort_hook
                ;;
        esac

        if [ "$decision" = allow ] && [ "$scope" = session ]; then
            printf '%s\n' "$tool_class" >> "$session_allow_file" 2>/dev/null || {
                remove_decision
                abort_hook
            }
        fi

        rm -f "$pending_file" "$decision_file" >/dev/null 2>&1 || exit 0
        [ ! -e "$pending_file" ] || exit 0
        [ ! -e "$decision_file" ] || exit 0
        pending_file=
        decision_file=
        if [ "$decision" = allow ]; then
            printf '%s\n' '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"allow","permissionDecisionReason":"Approved from Vibenotch"}}'
        else
            printf '%s\n' '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"deny","permissionDecisionReason":"Denied from Vibenotch"}}'
        fi
        exit 0
    fi

    [ -f "$pending_file" ] || exit 0
    poll_count=$((poll_count + 1))
    [ "$poll_count" -lt 80 ] || break
    sleep 0.25 >/dev/null 2>&1 || abort_hook
done

remove_pending
exit 0
