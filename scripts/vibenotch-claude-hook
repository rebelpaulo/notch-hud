#!/bin/sh

status=${1:-}
case $status in
    starting|working|tool|needs_me|done|remove|notify) ;;
    *) exit 0 ;;
esac

command -v jq >/dev/null 2>&1 || exit 0

payload=$(cat 2>/dev/null)
session_id=$(printf '%s' "$payload" | jq -r '.session_id // empty' 2>/dev/null)
cwd=$(printf '%s' "$payload" | jq -r '.cwd // empty' 2>/dev/null)
model=$(printf '%s' "$payload" | jq -r '.model // empty' 2>/dev/null)

[ -n "$session_id" ] || exit 0

script_dir=$(CDPATH= cd -P "$(dirname "$0")" 2>/dev/null && pwd)
emitter=$script_dir/vibenotch-emit
[ -x "$emitter" ] || exit 0

id=claude-$session_id
if [ "$status" = remove ]; then
    "$emitter" "$id" claude-code remove --remove >/dev/null 2>&1
    exit 0
fi

project=
if [ -n "$cwd" ]; then
    project=$(basename "$cwd" 2>/dev/null)
fi
notch_home=${VIBENOTCH_HOME:-"$HOME/.vibenotch"}
session_file=$notch_home/sessions/$id.json

emit_status() {
    emit_value=$1
    shift
    if [ -n "$cwd" ]; then
        set -- --cwd "$cwd" "$@"
        if [ ! -f "$session_file" ]; then
            set -- --project "$project" "$@"
        fi
    fi
    if [ -n "$model" ]; then
        set -- --model "$model" "$@"
    fi
    "$emitter" "$id" claude-code "$emit_value" "$@" >/dev/null 2>&1
}

single_line() {
    tr '\r\n' '  '
}

if [ "$status" = notify ]; then
    message=$(printf '%s' "$payload" | jq -r '
        [
            .message,
            .title,
            .notification.message,
            .notification.title
        ]
        | map(select(type == "string" and length > 0))
        | first
        // empty
    ' 2>/dev/null | single_line | cut -c 1-80)
    if [ -n "$message" ]; then
        emit_status needs_me --detail "$message"
    else
        emit_status needs_me
    fi
    exit 0
fi

if [ "$status" = working ]; then
    prompt=$(printf '%s' "$payload" | jq -r '.prompt // empty' 2>/dev/null)
    # Skip harness-injected turns (task notifications, system reminders, command output)
    case "$prompt" in
      "<"*|"["*|*task-notification*|*system-reminder*) prompt="" ;;
    esac
    if [ -n "$prompt" ]; then
        recorded_task=
        if [ -f "$session_file" ]; then
            recorded_task=$(jq -r '.task // empty' "$session_file" 2>/dev/null)
        fi

        if [ -z "$recorded_task" ]; then
            task=$(printf '%s' "$prompt" | single_line | cut -c 1-60)
            emit_status working --prompt "$prompt" --task "$task"
        else
            emit_status working --prompt "$prompt"
        fi
    else
        emit_status working
    fi
    exit 0
fi

# Sessions launched at a workspace root show the workspace folder as project.
# When a tool touches a path inside a git repo directly under cwd, that repo
# is the real project — refine it. (The desktop app's session title lives in
# its IndexedDB and is not reachable from hook payloads.) Workspace symlink
# aliases are intentionally attributed by alias; physical-path mismatches fail safe.
project_from_path() {
    candidate=$1
    [ -n "$cwd" ] || return 1
    [ "$cwd" != / ] || return 1
    [ -n "$candidate" ] || return 1
    project_cwd=$cwd
    case $project_cwd in
        */) project_cwd=${project_cwd%/} ;;
    esac
    [ -e "$project_cwd/.git" ] && return 1
    case $candidate in
        */../*|*/..|*/./*|..) return 1 ;;
    esac
    case $candidate in
        "$project_cwd"/*) ;;
        *) return 1 ;;
    esac
    relative=${candidate#"$project_cwd"/}
    segment=${relative%%/*}
    [ -n "$segment" ] || return 1
    [ -e "$project_cwd/$segment/.git" ] || return 1
    printf '%s\n' "$segment"
}

cd_path() {
    cd_command=$1
    cd_command=${cd_command%%'&&'*}
    cd_command=${cd_command%%';'*}
    cd_command=${cd_command%%'||'*}
    cd_command=${cd_command%%"
"*}
    cd_command=$(printf '%s' "$cd_command" | sed \
        -e 's/^[[:space:]]*//' \
        -e 's/[[:space:]]*$//' \
        -e 's/^cd  */cd /')

    case $cd_command in
        cd\ *) target=${cd_command#cd } ;;
        *) return 1 ;;
    esac

    while :; do
        case $target in
            -L\ *|-P\ *) target=${target#??} ;;
            --\ *) target=${target#--} ;;
            -L|-P|--) return 1 ;;
            *) break ;;
        esac
        while [ "${target# }" != "$target" ]; do
            target=${target# }
        done
    done
    [ -n "$target" ] || return 1
    [ "$target" != - ] || return 1

    case $target in
        \"*\") target=${target#\"}; target=${target%\"} ;;
        \'*\') target=${target#\'}; target=${target%\'} ;;
    esac
    case $target in
        *\"*|*\'*|*\\*|*'$'*|*'`'*|*'('*|*')'*|*"
"*) return 1 ;;
    esac
    [ -n "$target" ] || return 1

    case $target in
        /*) ;;
        \~/*) target=$HOME/${target#\~/} ;;
        ./*) target=$cwd/${target#./} ;;
        *) target=$cwd/$target ;;
    esac
    printf '%s\n' "$target"
}

if [ "$status" = tool ]; then
    tool_name=$(printf '%s' "$payload" | jq -r '.tool_name // empty' 2>/dev/null)
    tool_line=

    tool_path=

    case $tool_name in
        Bash)
            full_command=$(printf '%s' "$payload" | jq -r '.tool_input.command // empty' 2>/dev/null)
            command=$(printf '%s' "$full_command" | single_line | cut -c 1-48)
            tool_line=Bash
            [ -n "$command" ] && tool_line="Bash $command"
            tool_path=$(cd_path "$full_command")
            ;;
        Edit|Write|Read|NotebookEdit)
            file_path=$(printf '%s' "$payload" | jq -r '.tool_input.file_path // .tool_input.notebook_path // empty' 2>/dev/null)
            file_name=${file_path##*/}
            tool_line=$tool_name
            [ -n "$file_name" ] && tool_line="$tool_name $file_name"
            tool_path=$file_path
            ;;
        Grep|Glob)
            pattern=$(printf '%s' "$payload" | jq -r '.tool_input.pattern // empty' 2>/dev/null | single_line | cut -c 1-32)
            tool_line=$tool_name
            [ -n "$pattern" ] && tool_line="$tool_name $pattern"
            # searches often carry an explicit path — refine from it too
            tool_path=$(printf '%s' "$payload" | jq -r '.tool_input.path // empty' 2>/dev/null)
            case $tool_path in
                ""|/*) ;;
                ./*) tool_path=$cwd/${tool_path#./} ;;
                *) tool_path=$cwd/$tool_path ;;
            esac
            ;;
        Task|Agent)
            description=$(printf '%s' "$payload" | jq -r '.tool_input.description // "subtask"' 2>/dev/null | single_line)
            tool_line="Agent $description"
            ;;
        *)
            tool_line=$tool_name
            ;;
    esac

    set --
    if [ -n "$tool_line" ]; then
        set -- --tool-line "$tool_line"
    fi
    repo_project=$(project_from_path "$tool_path")
    if [ -n "$repo_project" ]; then
        set -- "$@" --project "$repo_project"
    fi
    emit_status working "$@"
    exit 0
fi

emit_status "$status"
exit 0
