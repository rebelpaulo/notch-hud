#!/bin/sh

# A chained notifier inherits this variable. Any route back into Vibenotch is
# therefore stopped before it emits or starts another child, even when an
# opaque wrapper escaped the static chain validation.
notify_depth=${VIBENOTCH_NOTIFY_DEPTH:-0}
if [ "$notify_depth" != 0 ]; then
    printf '%s\n' \
        "vibenotch: warning: blocked recursive Codex notification at depth $notify_depth" >&2
    exit 0
fi

payload=
for argument do
    payload=$argument
done

script_dir=$(CDPATH= cd -P "$(dirname "$0")" 2>/dev/null && pwd)
notch_home=${VIBENOTCH_HOME:-"$HOME/.vibenotch"}

# Environment variables alone are not a sufficient recursion boundary: an
# opaque relay can clear them. Hold an atomic, per-payload shlock while the
# notification is active so a descendant with the same event is still denied.
# Different payloads use different keys and continue to run concurrently.
guard_root=$notch_home/codex-notify-guards
guard_key=$(printf '%s' "$payload" | /usr/bin/shasum -a 256 2>/dev/null | /usr/bin/awk '{ print $1 }')
guard_file=$guard_root/$guard_key.lock
guard_acquired=0

if [ -n "$guard_key" ] \
   && (umask 077 && mkdir -p "$guard_root") 2>/dev/null \
   && /usr/bin/shlock -p "$$" -f "$guard_file" 2>/dev/null
then
    guard_acquired=1
fi

if [ "$guard_acquired" -ne 1 ]; then
    printf '%s\n' \
        "vibenotch: warning: blocked duplicate or recursive Codex notification" >&2
    exit 0
fi

cleanup_notify_guard() {
    current_guard_owner=$(sed -n '1p' "$guard_file" 2>/dev/null | tr -d '[:space:]')
    if [ "$current_guard_owner" = "$$" ]; then
        rm -f "$guard_file" 2>/dev/null || :
    fi
}
trap cleanup_notify_guard EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

emitter=$script_dir/vibenotch-emit
if [ ! -x "$emitter" ]; then
    emitter=$notch_home/bin/vibenotch-emit
fi

payload_type=
if command -v jq >/dev/null 2>&1; then
    payload_type=$(printf '%s' "$payload" | jq -r '
        if type == "object" and (.type | type) == "string" then .type else empty end
    ' 2>/dev/null)
fi

status=
case $payload_type in
    agent-turn-complete)
        status=done
        ;;
    *[Aa][Pp][Pp][Rr][Oo][Vv][Aa][Ll]*)
        status=needs_me
        ;;
esac

if [ -n "$status" ] && [ -x "$emitter" ]; then
    payload_client=$(printf '%s' "$payload" | jq -r '.client // empty' 2>/dev/null)
    payload_id=$(printf '%s' "$payload" | jq -r '
        [
            .["thread-id"], .thread_id, (try .thread.id),
            .["conversation-id"], .conversation_id, (try .conversation.id)
        ]
        | map(select(type == "string" or type == "number"))
        | first
        // empty
        | tostring
    ' 2>/dev/null)

    if [ -n "${NOTCH_CODEX_SESSION_ID:-}" ] || [ "$payload_client" != "Codex Desktop" ]; then
        # Shim/CLI path. Update-only: notify never CREATES these sessions.
        # The shim owns the lifecycle; codex fires notify asynchronously, so a
        # late turn-complete arriving after the shim's exit --remove would
        # otherwise resurrect the entry as a ghost (and shim-less codex runs
        # would spawn done-only ghosts).
        session_id=${NOTCH_CODEX_SESSION_ID:-}
        if [ -z "$session_id" ]; then
            if [ -n "$payload_id" ]; then
                session_id=codex-$payload_id
            else
                session_id=codex-$PPID
            fi
        fi
        if [ -f "$notch_home/sessions/$session_id.json" ]; then
            "$emitter" "$session_id" codex "$status" --source codex >/dev/null 2>&1 || :
        fi
    elif [ -n "$payload_id" ]; then
        # Codex Desktop app turn: creation allowed — the entry is backed by a
        # real app session (same codex-app-<uuid8> keying as the rollout
        # poller), and StalenessSweeper drops it 15min after the last turn.
        session_id=codex-app-$(printf '%s' "$payload_id" | cut -c 1-8)
        payload_cwd=$(printf '%s' "$payload" | jq -r '.cwd // empty' 2>/dev/null)
        set -- --source codex-desktop
        if [ -n "$payload_cwd" ]; then
            set -- "$@" --cwd "$payload_cwd" --project "$(basename "$payload_cwd")"
        fi
        "$emitter" "$session_id" codex "$status" "$@" >/dev/null 2>&1 || :
    fi
fi

chain_file=$notch_home/codex-notify-chain.json
if [ -f "$chain_file" ] && command -v jq >/dev/null 2>&1; then
    # Keep this filter in sync with scripts/install-codex-adapter.sh. Runtime
    # validation is deliberately repeated here because users can edit the
    # chain after installation.
    sanitized_chain=$(jq -ce --arg target "$script_dir/vibenotch-codex-notify" '
        def is_vibenotch($target):
            type == "string"
            and (
                . == $target
                or endswith("/vibenotch-codex-notify")
                or endswith("/notch-codex-notify")
            );
        def mentions_vibenotch_executable:
            type == "string"
            and (
                contains("vibenotch-codex-notify")
                or contains("notch-codex-notify")
            );
        def decoded_command:
            if type == "array" then .
            elif type == "string" then (try fromjson catch null)
            else null
            end;
        def valid_command:
            type == "array"
            and length > 0
            and all(.[]; type == "string")
            and .[0] != "";
        def is_shell:
            type == "string" and test("(^|/)(ba|z|da|k)?sh$");
        def directly_calls_vibenotch($target):
            (length > 0 and (.[0] | is_vibenotch($target)))
            or (length > 1 and (.[0] | is_shell) and (.[1] | is_vibenotch($target)))
            or (
                length > 1
                and (.[0] | type == "string")
                and (.[0] | test("(^|/)env$"))
                and any(.[1:][];
                    is_vibenotch($target) or mentions_vibenotch_executable
                )
            );
        def sanitize_command($target; $depth):
            if $depth >= 16 then []
            elif (valid_command | not) then []
            elif directly_calls_vibenotch($target) then
                if (.[0] | is_vibenotch($target)) then
                    map(select((is_vibenotch($target)) | not))
                    | sanitize_command($target; $depth + 1)
                else []
                end
            else . as $command
            | reduce range(0; $command | length) as $index (
                {output: [], skip_until: 0};
                if $index < .skip_until then .
                elif $command[$index] == "--previous-notify"
                     and ($index + 1) < ($command | length)
                then ($command[$index + 1] | decoded_command) as $nested
                | if ($nested | valid_command) then
                    ($nested | sanitize_command($target; $depth + 1)) as $clean
                    | if ($clean | length) == 0 then
                        .skip_until = ($index + 2)
                      elif $clean == $nested then
                        .output += ["--previous-notify", $command[$index + 1]]
                        | .skip_until = ($index + 2)
                      else
                        .output += ["--previous-notify", ($clean | tojson)]
                        | .skip_until = ($index + 2)
                      end
                  else .output += [$command[$index]]
                  end
                elif ($command[$index] | startswith("--previous-notify="))
                then (
                    $command[$index]
                    | ltrimstr("--previous-notify=")
                    | decoded_command
                ) as $nested
                | if ($nested | valid_command) then
                    ($nested | sanitize_command($target; $depth + 1)) as $clean
                    | if ($clean | length) == 0 then .
                      elif $clean == $nested then .output += [$command[$index]]
                      else .output += ["--previous-notify=" + ($clean | tojson)]
                      end
                  else .output += [$command[$index]]
                  end
                else .output += [$command[$index]]
                end
            )
            | .output
            end;
        if type != "array"
           or length == 0
           or (all(.[]; type == "string") | not)
           or .[0] == ""
        then error("invalid notify command")
        else sanitize_command($target; 0)
        end
    ' "$chain_file" 2>/dev/null) || sanitized_chain=

    if [ -z "$sanitized_chain" ] || [ "$sanitized_chain" = "[]" ]; then
        printf '%s\n' \
            "vibenotch: warning: blocked invalid or circular Codex notify chain in $chain_file" >&2
        chain_arguments=
    else
        original_chain=$(jq -c . "$chain_file" 2>/dev/null) || original_chain=
        if [ "$sanitized_chain" != "$original_chain" ]; then
            printf '%s\n' \
                "vibenotch: warning: blocked circular --previous-notify callback in $chain_file" >&2
        fi
        chain_arguments=$(printf '%s\n' "$sanitized_chain" | jq -r '@sh' 2>/dev/null)
    fi
    if [ -n "$chain_arguments" ]; then
        # jq @sh supplies the quoting needed to restore each JSON array element.
        # shellcheck disable=SC2294
        eval "set -- $chain_arguments"
        if [ -n "$payload" ]; then
            set -- "$@" "$payload"
        fi
        VIBENOTCH_NOTIFY_DEPTH=1 "$@" || :
    fi
fi

exit 0
