+import SwiftUI
+
+struct NotchPeekView: View {
+    private let statusColors: [Color] = [.statusBlue, .statusYellow, .statusGreen]
+
+    var body: some View {
+        HStack(spacing: 7) {
+            Text("3")
+                .font(.system(size: 13, weight: .semibold, design: .rounded))
+                .foregroundStyle(.white)
+
+            HStack(spacing: 4) {
+                ForEach(Array(statusColors.enumerated()), id: \.offset) { _, color in
+                    Circle()
+                        .fill(color)
+                        .frame(width: 6, height: 6)
+                }
+            }
+        }
+        .padding(.horizontal, 10)
+        .padding(.vertical, 6)
+        .background(Color.notchBackground)
+        .clipShape(.rect(cornerRadius: 10))
+        .fixedSize()
+        .accessibilityElement(children: .ignore)
+        .accessibilityLabel("3 active sessions")
+    }
+}
+
