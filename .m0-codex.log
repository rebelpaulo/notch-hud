+import SwiftUI
+
+struct NotchPanelView: View {
+    private let sessions = [
+        SessionRowView.Session(projectName: "vibenotch", statusColor: .statusBlue),
+        SessionRowView.Session(projectName: "billing-service", statusColor: .statusYellow),
+        SessionRowView.Session(projectName: "docs-refresh", statusColor: .statusGreen)
+    ]
+
+    var body: some View {
+        VStack(alignment: .leading, spacing: 12) {
+            HStack {
+                Text("Active sessions")
+                    .font(.system(size: 13, weight: .semibold))
+                    .foregroundStyle(.white)
+
+                Spacer()
+
+                Text("3")
+                    .font(.system(size: 12, weight: .medium, design: .rounded))
+                    .foregroundStyle(.white.opacity(0.6))
+            }
+
+            Divider()
+                .overlay(.white.opacity(0.12))
+
+            VStack(spacing: 5) {
+                ForEach(sessions) { session in
+                    SessionRowView(session: session)
+                }
+            }
+        }
+        .padding(14)
+        .frame(width: 320)
+        .background(Color.notchBackground)
+        .clipShape(.rect(cornerRadius: 10))
+        .overlay {
+            RoundedRectangle(cornerRadius: 10)
+                .stroke(.white.opacity(0.08), lineWidth: 1)
+        }
+    }
+}
