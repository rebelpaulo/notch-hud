    fileprivate func trackingViewMouseEntered(_ view: NotchTrackingView) {
        setPointerInside(true)
    }

    fileprivate func trackingViewMouseExited(_ view: NotchTrackingView) {
        updatePointerState(at: NSEvent.mouseLocation)
    }
}

