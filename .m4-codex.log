+    prefix=$1
+    [ -n "$prefix" ] || return 1
+    case $command_value in
+        "$prefix"*) return 0 ;;
+        *) return 1 ;;
+    esac
+}
+
+allow_entry_matches() {
+    entry=$1
+
+    if [ "$entry" = "$tool_name" ]; then
+        return 0
+    fi
+    [ "$tool_name" = Bash ] || return 1
+
+    case $entry in
+        Bash\(*:\*\))
+            prefix=${entry#Bash(}
+            prefix=${prefix%:\*)}
+            [ "$entry" = "Bash($prefix:*)" ] || return 1
+            command_begins_with "$prefix"
+            return $?
+            ;;
+        Bash\(*\ \*\))
+            prefix=${entry#Bash(}
+            prefix=${prefix% \*)}
+            [ "$entry" = "Bash($prefix *)" ] || return 1
+            command_begins_with "$prefix"
+            return $?
+            ;;
+    esac
+
+    return 1
+}
