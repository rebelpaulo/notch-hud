#!/bin/sh

if [ "$#" -lt 3 ]; then
    exit 0
fi

id=$1
agent=$2
status=$3
shift 3

detail=
project=
cwd=
pid=
task=
prompt=
tool_line=
model=
detail_set=0
project_set=0
cwd_set=0
pid_set=0
task_set=0
prompt_set=0
tool_line_set=0
model_set=0
remove=0

while [ "$#" -gt 0 ]; do
    case $1 in
        --detail)
            [ "$#" -ge 2 ] || exit 0
            detail=$2
            detail_set=1
            shift 2
            ;;
        --project)
            [ "$#" -ge 2 ] || exit 0
            project=$2
            project_set=1
            shift 2
            ;;
        --cwd)
            [ "$#" -ge 2 ] || exit 0
            cwd=$2
            cwd_set=1
            shift 2
            ;;
        --pid)
            [ "$#" -ge 2 ] || exit 0
            pid=$2
            pid_set=1
            shift 2
            ;;
        --task)
            [ "$#" -ge 2 ] || exit 0
            task=$2
            task_set=1
            shift 2
            ;;
        --prompt)
            [ "$#" -ge 2 ] || exit 0
            prompt=$2
            prompt_set=1
            shift 2
            ;;
        --tool-line)
            [ "$#" -ge 2 ] || exit 0
            tool_line=$2
            tool_line_set=1
            shift 2
            ;;
        --model)
            [ "$#" -ge 2 ] || exit 0
            model=$2
            model_set=1
            shift 2
            ;;
        --remove)
            remove=1
            shift
            ;;
        *)
            shift
            ;;
    esac
done

case $id in
    ""|*/*)
        exit 0
        ;;
esac

notch_home=${VIBENOTCH_HOME:-"$HOME/.vibenotch"}
spool_dir=$notch_home/sessions
seq_dir=$notch_home/seq
session_file=$spool_dir/$id.json
seq_file=$seq_dir/$id

mkdir -p "$spool_dir" "$seq_dir" >/dev/null 2>&1 || exit 0

if [ "$remove" -eq 1 ]; then
    rm -f "$session_file" "$seq_file" >/dev/null 2>&1
    exit 0
fi

command -v jq >/dev/null 2>&1 || exit 0

seq=0
if [ -f "$seq_file" ]; then
    seq=$(sed -n '1p' "$seq_file" 2>/dev/null)
fi
case $seq in
    ""|*[!0-9]*) seq=0 ;;
esac
seq=$((seq + 1))
printf '%s\n' "$seq" > "$seq_file" 2>/dev/null || exit 0

case $pid in
    ""|*[!0-9]*) pid_json=null ;;
    *) pid_json=$pid ;;
esac

# Find the controlling tty by walking up the ppid chain.
find_tty() {
    pid=$$
    i=0
    while [ "$pid" -gt 1 ] && [ "$i" -lt 25 ]; do
        t=$(ps -o tty= -p "$pid" 2>/dev/null | tr -d ' ')
        case "$t" in
            ttys*) printf '/dev/%s\n' "$t"; return 0 ;;
        esac
        pid=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')
        [ -z "$pid" ] && break
        i=$((i+1))
    done
    return 0
}

terminal_tty=$(find_tty)

updated=$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null)
tmp_file=$spool_dir/$id.json.tmp.$$
old_payload={}
if [ -f "$session_file" ]; then
    candidate=$(jq -c 'if type == "object" then . else {} end' "$session_file" 2>/dev/null)
    if [ -n "$candidate" ]; then
        old_payload=$candidate
    fi
fi

if jq -n \
    --argjson old "$old_payload" \
    --arg id "$id" \
    --arg agent "$agent" \
    --arg status "$status" \
    --arg detail "$detail" \
    --arg project "$project" \
    --arg cwd "$cwd" \
    --arg task "$task" \
    --arg prompt "$prompt" \
    --arg tool_line "$tool_line" \
    --arg model "$model" \
    --arg updated "$updated" \
    --arg term_program "${TERM_PROGRAM:-}" \
    --arg tty "$terminal_tty" \
    --arg iterm_session_id "${ITERM_SESSION_ID:-}" \
    --arg wezterm_pane "${WEZTERM_PANE:-}" \
    --arg kitty_window_id "${KITTY_WINDOW_ID:-}" \
    --arg window_id "${WINDOWID:-}" \
    --argjson pid "$pid_json" \
    --argjson seq "$seq" \
    --argjson detail_set "$detail_set" \
    --argjson project_set "$project_set" \
    --argjson cwd_set "$cwd_set" \
    --argjson pid_set "$pid_set" \
    --argjson task_set "$task_set" \
    --argjson prompt_set "$prompt_set" \
    --argjson tool_line_set "$tool_line_set" \
    --argjson model_set "$model_set" \
    '$old + {
        schema: 1,
        id: $id,
        agent: $agent,
        status: $status,
        updated: $updated,
        started: ($old.started // $updated),
        seq: $seq,
        terminal: (($old.terminal // {}) + ({
            termProgram: (if $term_program == "" then null else $term_program end),
            tty: (if $tty == "" then null else $tty end),
            itermSessionId: (if $iterm_session_id == "" then null else $iterm_session_id end),
            weztermPane: (if $wezterm_pane == "" then null else $wezterm_pane end),
            kittyWindowId: (if $kitty_window_id == "" then null else $kitty_window_id end),
            windowId: (if $window_id == "" then null else $window_id end)
        } | with_entries(select(.value != null)))),
        source: "vibenotch-emit"
    }
    + (if $pid_set == 1 then {pid: $pid} else {} end)
    + (if $project_set == 1 then
        {project: (if $project == "" then null else $project end)}
      else {} end)
    + (if $cwd_set == 1 then
        {cwd: (if $cwd == "" then null else $cwd end)}
      else {} end)
    + (if $detail_set == 1 then
        {detail: (if $detail == "" then null else $detail end)}
      else {} end)
    + (if $task_set == 1 then
        {task: (if $task == "" then null else $task end)}
      else {} end)
    + (if $prompt_set == 1 then
        {prompt: (if $prompt == "" then null else $prompt end)}
      else {} end)
    + (if $tool_line_set == 1 then
        {toolLine: (if $tool_line == "" then null else $tool_line end)}
      else {} end)
    + (if $model_set == 1 then
        {model: (if $model == "" then null else $model end)}
      else {} end)' > "$tmp_file" 2>/dev/null
then
    mv -f "$tmp_file" "$session_file" >/dev/null 2>&1
else
    rm -f "$tmp_file" >/dev/null 2>&1
fi

exit 0
#!/bin/sh

status=${1:-}
case $status in
    starting|working|tool|needs_me|done|remove) ;;
    *) exit 0 ;;
esac

command -v jq >/dev/null 2>&1 || exit 0

payload=$(cat 2>/dev/null)
session_id=$(printf '%s' "$payload" | jq -r '.session_id // empty' 2>/dev/null)
cwd=$(printf '%s' "$payload" | jq -r '.cwd // empty' 2>/dev/null)
model=$(printf '%s' "$payload" | jq -r '.model // empty' 2>/dev/null)

[ -n "$session_id" ] || exit 0

script_dir=$(CDPATH= cd -P "$(dirname "$0")" 2>/dev/null && pwd)
emitter=$script_dir/vibenotch-emit
[ -x "$emitter" ] || exit 0

id=claude-$session_id
if [ "$status" = remove ]; then
    "$emitter" "$id" claude-code remove --remove >/dev/null 2>&1
    exit 0
fi

project=
if [ -n "$cwd" ]; then
    project=$(basename "$cwd" 2>/dev/null)
fi

emit_status() {
    emit_value=$1
    shift
    if [ -n "$cwd" ]; then
        set -- --cwd "$cwd" --project "$project" "$@"
    fi
    if [ -n "$model" ]; then
        set -- --model "$model" "$@"
    fi
    "$emitter" "$id" claude-code "$emit_value" "$@" >/dev/null 2>&1
}

single_line() {
    tr '\r\n' '  '
}

if [ "$status" = working ]; then
    prompt=$(printf '%s' "$payload" | jq -r '.prompt // empty' 2>/dev/null)
    # Skip harness-injected turns (task notifications, system reminders, command output)
    case "$prompt" in
      "<"*|"["*|*task-notification*|*system-reminder*) prompt="" ;;
    esac
    if [ -n "$prompt" ]; then
        notch_home=${VIBENOTCH_HOME:-"$HOME/.vibenotch"}
        session_file=$notch_home/sessions/$id.json
        recorded_task=
        if [ -f "$session_file" ]; then
            recorded_task=$(jq -r '.task // empty' "$session_file" 2>/dev/null)
        fi

        if [ -z "$recorded_task" ]; then
            task=$(printf '%s' "$prompt" | single_line | cut -c 1-60)
            emit_status working --prompt "$prompt" --task "$task"
        else
            emit_status working --prompt "$prompt"
        fi
    else
        emit_status working
    fi
    exit 0
fi

if [ "$status" = tool ]; then
    tool_name=$(printf '%s' "$payload" | jq -r '.tool_name // empty' 2>/dev/null)
    tool_line=

    case $tool_name in
        Bash)
            command=$(printf '%s' "$payload" | jq -r '.tool_input.command // empty' 2>/dev/null | single_line | cut -c 1-48)
            tool_line=Bash
            [ -n "$command" ] && tool_line="Bash $command"
            ;;
        Edit|Write|Read|NotebookEdit)
            file_path=$(printf '%s' "$payload" | jq -r '.tool_input.file_path // empty' 2>/dev/null)
            file_name=${file_path##*/}
            tool_line=$tool_name
            [ -n "$file_name" ] && tool_line="$tool_name $file_name"
            ;;
        Grep|Glob)
            pattern=$(printf '%s' "$payload" | jq -r '.tool_input.pattern // empty' 2>/dev/null | single_line | cut -c 1-32)
            tool_line=$tool_name
            [ -n "$pattern" ] && tool_line="$tool_name $pattern"
            ;;
        Task|Agent)
            description=$(printf '%s' "$payload" | jq -r '.tool_input.description // "subtask"' 2>/dev/null | single_line)
            tool_line="Agent $description"
            ;;
        *)
            tool_line=$tool_name
            ;;
    esac

    if [ -n "$tool_line" ]; then
        emit_status working --tool-line "$tool_line"
    else
        emit_status working
    fi
    exit 0
fi

emit_status "$status"
exit 0
import Darwin
import Foundation

final class SpoolWatcher: @unchecked Sendable {
    private let spoolURL: URL
    private let store: SessionStore
    private let fileManager: FileManager
    private let reader = SpoolReader()
    private let ioQueue = DispatchQueue(label: "com.vibenotch.spool-watcher", qos: .utility)

    private var source: DispatchSourceFileSystemObject?
    private var debounceWorkItem: DispatchWorkItem?
    private var reopenWorkItem: DispatchWorkItem?
    private var sessionsByID: [String: Session] = [:]
    private var isRunning = false
    private var reopenDelay: TimeInterval = 0.25

    init(spoolURL: URL, store: SessionStore, fileManager: FileManager = .default) {
        self.spoolURL = spoolURL
        self.store = store
        self.fileManager = fileManager
    }

    func start() {
        ioQueue.async { [weak self] in
            guard let self, !self.isRunning else { return }
            self.isRunning = true
            self.openDirectorySource()
        }
    }

    func stop() {
        ioQueue.async { [weak self] in
            guard let self else { return }
            self.isRunning = false
            self.debounceWorkItem?.cancel()
            self.debounceWorkItem = nil
            self.reopenWorkItem?.cancel()
            self.reopenWorkItem = nil
            self.closeDirectorySource()
        }
    }

    private func openDirectorySource() {
        guard isRunning else { return }

        do {
            try fileManager.createDirectory(
                at: spoolURL,
                withIntermediateDirectories: true,
                attributes: [.posixPermissions: NSNumber(value: 0o700)]
            )
        } catch {
            scheduleReopen()
            return
        }

        let fileDescriptor: Int32 = spoolURL.withUnsafeFileSystemRepresentation { path in
            guard let path else { return Int32(-1) }
            return Darwin.open(path, O_EVTONLY)
        }
        guard fileDescriptor >= 0 else {
            scheduleReopen()
            return
        }

        let source = DispatchSource.makeFileSystemObjectSource(
            fileDescriptor: fileDescriptor,
            eventMask: [.write, .delete, .rename, .extend],
            queue: ioQueue
        )
        source.setEventHandler { [weak self] in
            self?.handleDirectoryEvent()
        }
        source.setCancelHandler {
            _ = Darwin.close(fileDescriptor)
        }

        self.source = source
        reopenDelay = 0.25
        source.resume()
        rescan()
    }

    private func handleDirectoryEvent() {
        guard let source else { return }
        let event = source.data

        if event.contains(.delete) || event.contains(.rename) {
            closeDirectorySource()
            scheduleReopen()
            return
        }

        scheduleRescan(after: 0.15)
    }

    private func scheduleRescan(after delay: TimeInterval) {
        debounceWorkItem?.cancel()
        let workItem = DispatchWorkItem { [weak self] in
            self?.rescan()
        }
        debounceWorkItem = workItem
        ioQueue.asyncAfter(deadline: .now() + delay, execute: workItem)
    }

    private func rescan() {
        guard isRunning else { return }

        let fileURLs: [URL]
        do {
            fileURLs = try fileManager.contentsOfDirectory(
                at: spoolURL,
                includingPropertiesForKeys: nil,
                options: [.skipsHiddenFiles]
            )
        } catch {
            closeDirectorySource()
            scheduleReopen()
            return
        }

        var scannedSessions: [String: Session] = [:]
        var failedIDs = Set<String>()

        for fileURL in fileURLs where fileURL.pathExtension.lowercased() == "json" {
            guard let session = reader.read(at: fileURL) else {
                failedIDs.insert(fileURL.deletingPathExtension().lastPathComponent)
                continue
            }

            if let scanned = scannedSessions[session.id] {
                if shouldUse(session, insteadOf: scanned) {
                    scannedSessions[session.id] = session
                }
            } else {
                scannedSessions[session.id] = session
            }
        }

        var nextSessions: [String: Session] = [:]
        for (id, session) in scannedSessions {
            if let current = sessionsByID[id], !shouldUse(session, insteadOf: current) {
                nextSessions[id] = current
            } else {
                nextSessions[id] = session
            }
        }

        for id in failedIDs {
            if let current = sessionsByID[id] {
                nextSessions[id] = current
            }
        }

        sessionsByID = nextSessions
        let sessions = Array(nextSessions.values)
        Task { @MainActor [weak store = store] in
            store?.apply(sessions)
        }

        if !failedIDs.isEmpty {
            scheduleRescan(after: 0.5)
        }
    }

    private func shouldUse(_ candidate: Session, insteadOf current: Session) -> Bool {
        if candidate.seq > current.seq {
            return true
        }
        if candidate.seq < current.seq {
            return candidate.updatedAt > current.updatedAt
        }
        return candidate.updatedAt >= current.updatedAt
    }

    private func closeDirectorySource() {
        guard let source else { return }
        self.source = nil
        source.cancel()
    }

    private func scheduleReopen() {
        guard isRunning else { return }

        reopenWorkItem?.cancel()
        let delay = reopenDelay
        reopenDelay = min(reopenDelay * 2, 5)

        let workItem = DispatchWorkItem { [weak self] in
            guard let self, self.isRunning else { return }
            self.openDirectorySource()
        }
        reopenWorkItem = workItem
        ioQueue.asyncAfter(deadline: .now() + delay, execute: workItem)
    }
}
import Observation

@Observable
@MainActor
final class SessionStore {
    private(set) var sessions: [Session] = []

    func apply(_ sessions: [Session]) {
        self.sessions = sessions.sorted { lhs, rhs in
            let lhsRank = Self.sortRank(for: lhs.displayStatus)
            let rhsRank = Self.sortRank(for: rhs.displayStatus)

            if lhsRank != rhsRank {
                return lhsRank < rhsRank
            }
            let lhsCanFocus = lhs.terminal?.tty != nil
            let rhsCanFocus = rhs.terminal?.tty != nil
            if lhsCanFocus != rhsCanFocus {
                return lhsCanFocus
            }
            if lhs.updatedAt != rhs.updatedAt {
                return lhs.updatedAt > rhs.updatedAt
            }
            return lhs.id < rhs.id
        }
    }

    var counts: (working: Int, needsMe: Int, done: Int) {
        var working = 0
        var needsMe = 0
        var done = 0

        for session in sessions {
            switch session.displayStatus {
            case .working:
                working += 1
            case .needsMe:
                needsMe += 1
            case .done:
                done += 1
            case .idle:
                break
            }
        }

        return (working, needsMe, done)
    }

    var total: Int {
        sessions.count
    }

    private static func sortRank(for status: DisplayStatus) -> Int {
        switch status {
        case .needsMe:
            0
        case .working:
            1
        case .done:
            2
        case .idle:
            3
        }
    }
}
