     }
+
+    private func pulseOpacity(at date: Date) -> Double {
+        let phase = date.timeIntervalSinceReferenceDate.truncatingRemainder(dividingBy: 1)
+        return 0.925 + (0.075 * cos(phase * 2 * .pi))
