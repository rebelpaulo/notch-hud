 status=${1:-}
 case $status in
-    starting|working|tool|needs_me|done|remove) ;;
+    starting|working|tool|needs_me|done|remove|notify) ;;
     *) exit 0 ;;
 esac
 
@@ -46,6 +46,22 @@
     tr '\r\n' '  '
 }
 
+if [ "$status" = notify ]; then
+    message=$(printf '%s' "$payload" | jq -r '
+        .message
+        // .title
+        // .notification.message
+        // .notification.title
+        // empty
+    ' 2>/dev/null | single_line | cut -c 1-80)
+    if [ -n "$message" ]; then
+        emit_status needs_me --detail "$message"
+    else
+        emit_status needs_me
+    fi
+    exit 0
+fi
+
 if [ "$status" = working ]; then
     prompt=$(printf '%s' "$payload" | jq -r '.prompt // empty' 2>/dev/null)
     # Skip harness-injected turns (task notifications, system reminders, command output)

diff --git a/Sources/Vibenotch/App/AppEnvironment.swift b/Sources/Vibenotch/App/AppEnvironment.swift
index 65019d28ddef4c23f5d3556594983193d03c25c6..f663d8856a6d19980d50c60e74f02b94bff2af57
--- a/Sources/Vibenotch/App/AppEnvironment.swift
+++ b/Sources/Vibenotch/App/AppEnvironment.swift
@@ -2,26 +2,39 @@
 
 struct AppEnvironment {
     let spoolURL: URL
+    let pendingURL: URL
+    let decisionsURL: URL
     let workingStaleSeconds: TimeInterval = 90
     let dropSeconds: TimeInterval = 900
 
