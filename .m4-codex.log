 struct AppEnvironment {
     let spoolURL: URL
+    let pendingURL: URL
+    let decisionsURL: URL
     let workingStaleSeconds: TimeInterval = 90
     let dropSeconds: TimeInterval = 900
 
     init(fileManager: FileManager = .default) {
-        spoolURL = fileManager.homeDirectoryForCurrentUser
