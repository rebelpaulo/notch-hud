diff --git a/Sources/Vibenotch/Model/PendingApproval.swift b/Sources/Vibenotch/Model/PendingApproval.swift
new file mode 100644
index 0000000000000000000000000000000000000000..c55ce81c4b97b355823994da569108c532e8ab51
--- /dev/null
+++ b/Sources/Vibenotch/Model/PendingApproval.swift
@@ -0,0 +1,82 @@
+import Foundation
+
+struct PendingApproval: Codable, Identifiable, Equatable, Sendable {
+    struct BashBody: Codable, Equatable, Sendable {
+        let command: String?
+    }
+
+    struct EditBody: Codable, Equatable, Sendable {
+        let file: String?
+        let old: String?
+        let new: String?
+    }
+
+    struct WriteBody: Codable, Equatable, Sendable {
+        let file: String?
+        let content: String?
+    }
+
+    let schema: Int?
+    let sessionId: String
+    let tool: String
+    let cwd: String?
+    let created: String?
+    let summary: String?
+    let bash: BashBody?
+    let edit: EditBody?
+    let write: WriteBody?
+
+    var id: String { sessionId }
+
+    var projectName: String {
+        guard let cwd, !cwd.isEmpty else { return "Unknown project" }
+        let name = URL(fileURLWithPath: cwd).lastPathComponent
+        return name.isEmpty ? cwd : name
+    }
+}
+
+struct ApprovalDecision: Codable, Equatable, Sendable {
+    enum Decision: String, Codable, Sendable {
+        case allow
+        case deny
+    }
+
+    enum Scope: String, Codable, Sendable {
+        case once
+        case session
+    }
+
+    let decision: Decision
+    let scope: Scope
+}
+
+struct ApprovalDecisionWriter: Sendable {
+    let decisionsURL: URL
+    var fileManager: FileManager = .default
+
+    func write(_ decision: ApprovalDecision, for sessionID: String) throws {
+        guard !sessionID.isEmpty,
+              sessionID != ".",
+              sessionID != "..",
+              !sessionID.contains("/")
+        else {
+            throw CocoaError(.fileWriteInvalidFileName)
+        }
+
+        try fileManager.createDirectory(
+            at: decisionsURL,
+            withIntermediateDirectories: true,
+            attributes: [.posixPermissions: NSNumber(value: 0o700)]
+        )
+        try fileManager.setAttributes(
+            [.posixPermissions: NSNumber(value: 0o700)],
+            ofItemAtPath: decisionsURL.path
+        )
+
+        let encoder = JSONEncoder()
+        encoder.outputFormatting = [.sortedKeys]
+        let data = try encoder.encode(decision)
+        let destination = decisionsURL.appendingPathComponent("\(sessionID).json")
+        try data.write(to: destination, options: [.atomic])
+    }
+}
diff --git a/Sources/Vibenotch/Store/PendingStore.swift b/Sources/Vibenotch/Store/PendingStore.swift
new file mode 100644
index 0000000000000000000000000000000000000000..4d644e1303fab340fb0ca95efe99da99ab6f8057
--- /dev/null
+++ b/Sources/Vibenotch/Store/PendingStore.swift
@@ -0,0 +1,30 @@
+import Observation
+
+@Observable
+@MainActor
+final class PendingStore {
+    private(set) var approvals: [PendingApproval] = []
+
+    var current: PendingApproval? {
+        approvals.first
+    }
+
+    var hasPending: Bool {
+        !approvals.isEmpty
+    }
+
+    func apply(_ approvals: [PendingApproval]) {
+        self.approvals = approvals.sorted { lhs, rhs in
+            let lhsCreated = lhs.created ?? ""
+            let rhsCreated = rhs.created ?? ""
+            if lhsCreated != rhsCreated {
+                return lhsCreated < rhsCreated
+            }
+            return lhs.sessionId < rhs.sessionId
+        }
+    }
+
+    func dismiss(sessionID: String) {
+        approvals.removeAll { $0.sessionId == sessionID }
+    }
+}
diff --git a/Sources/Vibenotch/Store/PendingWatcher.swift b/Sources/Vibenotch/Store/PendingWatcher.swift
new file mode 100644
index 0000000000000000000000000000000000000000..b3aec19548e393341c46822f5629e6a96e3a8749
--- /dev/null
+++ b/Sources/Vibenotch/Store/PendingWatcher.swift
@@ -0,0 +1,178 @@
+import Darwin
+import Foundation
+
+final class PendingWatcher: @unchecked Sendable {
+    private let pendingURL: URL
+    private let fileManager: FileManager
+    private let onRescan: @MainActor @Sendable ([PendingApproval]) -> Void
+    private let ioQueue = DispatchQueue(label: "com.vibenotch.pending-watcher", qos: .utility)
+
+    private var source: DispatchSourceFileSystemObject?
+    private var debounceWorkItem: DispatchWorkItem?
+    private var reopenWorkItem: DispatchWorkItem?
+    private var approvalsByID: [String: PendingApproval] = [:]
+    private var isRunning = false
+    private var reopenDelay: TimeInterval = 0.25
+
+    init(
+        pendingURL: URL,
+        fileManager: FileManager = .default,
+        onRescan: @escaping @MainActor @Sendable ([PendingApproval]) -> Void
+    ) {
+        self.pendingURL = pendingURL
+        self.fileManager = fileManager
+        self.onRescan = onRescan
+    }
+
+    func start() {
+        ioQueue.async { [weak self] in
+            guard let self, !self.isRunning else { return }
+            self.isRunning = true
+            self.openDirectorySource()
+        }
+    }
+
+    func stop() {
+        ioQueue.async { [weak self] in
+            guard let self else { return }
+            self.isRunning = false
+            self.debounceWorkItem?.cancel()
+            self.debounceWorkItem = nil
+            self.reopenWorkItem?.cancel()
+            self.reopenWorkItem = nil
+            self.closeDirectorySource()
+        }
+    }
+
+    private func openDirectorySource() {
+        guard isRunning else { return }
+
+        do {
+            try fileManager.createDirectory(
+                at: pendingURL,
+                withIntermediateDirectories: true,
+                attributes: [.posixPermissions: NSNumber(value: 0o700)]
+            )
+        } catch {
+            scheduleReopen()
+            return
+        }
+
+        let fileDescriptor: Int32 = pendingURL.withUnsafeFileSystemRepresentation { path in
+            guard let path else { return Int32(-1) }
+            return Darwin.open(path, O_EVTONLY)
+        }
+        guard fileDescriptor >= 0 else {
+            scheduleReopen()
+            return
+        }
+
+        let source = DispatchSource.makeFileSystemObjectSource(
+            fileDescriptor: fileDescriptor,
+            eventMask: [.write, .delete, .rename, .extend],
+            queue: ioQueue
+        )
+        source.setEventHandler { [weak self] in
+            self?.handleDirectoryEvent()
+        }
+        source.setCancelHandler {
+            _ = Darwin.close(fileDescriptor)
+        }
+
+        self.source = source
+        reopenDelay = 0.25
+        source.resume()
+        rescan()
+    }
+
+    private func handleDirectoryEvent() {
+        guard let source else { return }
+        let event = source.data
+
+        if event.contains(.delete) || event.contains(.rename) {
+            closeDirectorySource()
+            scheduleReopen()
+            return
+        }
+
+        scheduleRescan(after: 0.15)
+    }
+
+    private func scheduleRescan(after delay: TimeInterval) {
+        debounceWorkItem?.cancel()
+        let workItem = DispatchWorkItem { [weak self] in
+            self?.rescan()
+        }
+        debounceWorkItem = workItem
+        ioQueue.asyncAfter(deadline: .now() + delay, execute: workItem)
+    }
+
+    private func rescan() {
+        guard isRunning else { return }
+
+        let fileURLs: [URL]
+        do {
+            fileURLs = try fileManager.contentsOfDirectory(
+                at: pendingURL,
+                includingPropertiesForKeys: nil,
+                options: [.skipsHiddenFiles]
+            )
+        } catch {
+            closeDirectorySource()
+            scheduleReopen()
+            return
+        }
+
+        var next: [String: PendingApproval] = [:]
+        var failedIDs = Set<String>()
+        let decoder = JSONDecoder()
+
+        for fileURL in fileURLs where fileURL.pathExtension.lowercased() == "json" {
+            guard let data = try? Data(contentsOf: fileURL),
+                  let approval = try? decoder.decode(PendingApproval.self, from: data),
+                  !approval.sessionId.isEmpty,
+                  !approval.sessionId.contains("/")
+            else {
+                failedIDs.insert(fileURL.deletingPathExtension().lastPathComponent)
+                continue
+            }
+            next[approval.sessionId] = approval
+        }
+
+        for failedID in failedIDs {
+            if let existing = approvalsByID[failedID] {
+                next[failedID] = existing
+            }
+        }
+
+        approvalsByID = next
+        let approvals = Array(next.values)
+        Task { @MainActor [onRescan] in
+            onRescan(approvals)
+        }
+
+        if !failedIDs.isEmpty {
+            scheduleRescan(after: 0.5)
+        }
+    }
+
+    private func closeDirectorySource() {
+        guard let source else { return }
+        self.source = nil
+        source.cancel()
+    }
+
+    private func scheduleReopen() {
+        guard isRunning else { return }
+
+        reopenWorkItem?.cancel()
+        let delay = reopenDelay
+        reopenDelay = min(reopenDelay * 2, 5)
+        let workItem = DispatchWorkItem { [weak self] in
+            guard let self, self.isRunning else { return }
+            self.openDirectorySource()
+        }
+        reopenWorkItem = workItem
+        ioQueue.asyncAfter(deadline: .now() + delay, execute: workItem)
+    }
+}
diff --git a/scripts/vibenotch-approve b/scripts/vibenotch-approve
new file mode 100644
index 0000000000000000000000000000000000000000..153c9e5fd66df9c33994ac0dc8bd52a9ee3fd01e
--- /dev/null
+++ b/scripts/vibenotch-approve
@@ -0,0 +1,272 @@
+#!/bin/sh
+
+# This hook must never replace Claude's own permission UI unless it has a
+# complete, explicit decision from Vibenotch.
+exec 2>/dev/null
+umask 077
+
+pending_file=
+decision_file=
+
+remove_pending() {
+    if [ -n "$pending_file" ]; then
+        rm -f "$pending_file" >/dev/null 2>&1
+    fi
+}
+
+remove_decision() {
+    if [ -n "$decision_file" ]; then
+        rm -f "$decision_file" >/dev/null 2>&1
+    fi
+}
+
+abort_hook() {
+    remove_pending
+    exit 0
+}
+
+trap 'abort_hook' HUP INT TERM
+
+command -v jq >/dev/null 2>&1 || exit 0
+
+payload=$(cat 2>/dev/null) || exit 0
+[ -n "$payload" ] || exit 0
+printf '%s' "$payload" | jq -e 'type == "object"' >/dev/null 2>&1 || exit 0
+
+notch_home=${VIBENOTCH_HOME:-"$HOME/.vibenotch"}
+config_file=$notch_home/config.json
+[ -f "$config_file" ] || exit 0
+jq -e 'type == "object" and .approvals == true' "$config_file" >/dev/null 2>&1 || exit 0
+
+# Find the controlling tty by walking up the ppid chain. This intentionally
+# matches vibenotch-emit so launchd/background sessions are never gated.
+find_tty() {
+    pid=$$
+    i=0
+    while [ "$pid" -gt 1 ] && [ "$i" -lt 25 ]; do
+        t=$(ps -o tty= -p "$pid" 2>/dev/null | tr -d ' ')
+        case "$t" in
+            ttys*) printf '/dev/%s\n' "$t"; return 0 ;;
+        esac
+        pid=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')
+        [ -z "$pid" ] && break
+        i=$((i+1))
+    done
+    return 0
+}
+
+terminal_tty=$(find_tty)
+[ -n "$terminal_tty" ] || exit 0
+
+tool_name=$(printf '%s' "$payload" | jq -r '.tool_name // empty' 2>/dev/null) || exit 0
+session_id=$(printf '%s' "$payload" | jq -r '.session_id // empty' 2>/dev/null) || exit 0
+cwd=$(printf '%s' "$payload" | jq -r '.cwd // empty' 2>/dev/null) || exit 0
+permission_mode=$(printf '%s' "$payload" | jq -r '.permission_mode // empty' 2>/dev/null) || exit 0
+
+[ "$permission_mode" = default ] || exit 0
+case $tool_name in
+    Edit|Write|NotebookEdit|Bash) ;;
+    *) exit 0 ;;
+esac
+case $session_id in
+    ""|.|..|*/*) exit 0 ;;
+esac
+
+command_value=
+tool_class=$tool_name
+if [ "$tool_name" = Bash ]; then
+    command_value=$(printf '%s' "$payload" | jq -r '.tool_input.command // empty' 2>/dev/null) || exit 0
+    first_word=$(printf '%s\n' "$command_value" | awk 'NF { print $1; exit }') || exit 0
+    tool_class=Bash:$first_word
+fi
+
+session_allow_dir=$notch_home/session-allow
+session_allow_file=$session_allow_dir/$session_id
+if [ -f "$session_allow_file" ]; then
+    if grep -F -x -q -- "$tool_class" "$session_allow_file" 2>/dev/null; then
+        printf '%s\n' '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"allow","permissionDecisionReason":"Vibenotch bypass"}}'
+        exit 0
+    fi
+fi
+
+command_begins_with() {
+    prefix=$1
+    [ -n "$prefix" ] || return 1
+    case $command_value in
+        "$prefix"*) return 0 ;;
+        *) return 1 ;;
+    esac
+}
+
+allow_entry_matches() {
+    entry=$1
+
+    if [ "$entry" = "$tool_name" ]; then
+        return 0
+    fi
+    [ "$tool_name" = Bash ] || return 1
+
+    case $entry in
+        Bash\(*:\*\))
+            prefix=${entry#Bash(}
+            prefix=${prefix%:\*)}
+            [ "$entry" = "Bash($prefix:*)" ] || return 1
+            command_begins_with "$prefix"
+            return $?
+            ;;
+        Bash\(*\ \*\))
+            prefix=${entry#Bash(}
+            prefix=${prefix% \*)}
+            [ "$entry" = "Bash($prefix *)" ] || return 1
+            command_begins_with "$prefix"
+            return $?
+            ;;
+    esac
+
+    return 1
+}
+
+settings_match=false
+check_settings_file() {
+    settings_file=$1
+    [ -f "$settings_file" ] || return 0
+
+    jq -e 'type == "object" and ((.permissions? // {}) | type == "object") and ((.permissions.allow? // []) | type == "array")' \
+        "$settings_file" >/dev/null 2>&1 || return 2
+
+    entries=$(jq -r '.permissions.allow? // [] | .[] | select(type == "string")' "$settings_file" 2>/dev/null) || return 2
+    while IFS= read -r entry; do
+        if allow_entry_matches "$entry"; then
+            settings_match=true
+            return 0
+        fi
+    done <<EOF
+$entries
+EOF
+    return 0
+}
+
+check_settings_file "$HOME/.claude/settings.json"
+[ "$?" -ne 2 ] || exit 0
+
+if [ "$settings_match" != true ] && [ -n "${CLAUDE_PROJECT_DIR:-}" ]; then
+    check_settings_file "$CLAUDE_PROJECT_DIR/.claude/settings.json"
+    [ "$?" -ne 2 ] || exit 0
+fi
+if [ "$settings_match" != true ] && [ -n "${CLAUDE_PROJECT_DIR:-}" ]; then
+    check_settings_file "$CLAUDE_PROJECT_DIR/.claude/settings.local.json"
+    [ "$?" -ne 2 ] || exit 0
+fi
+[ "$settings_match" = true ] && exit 0
+
+pending_dir=$notch_home/pending
+decisions_dir=$notch_home/decisions
+mkdir -p "$pending_dir" "$decisions_dir" "$session_allow_dir" >/dev/null 2>&1 || exit 0
+chmod 700 "$pending_dir" "$decisions_dir" "$session_allow_dir" >/dev/null 2>&1 || exit 0
+
+pending_file=$pending_dir/$session_id.json
+decision_file=$decisions_dir/$session_id.json
+pending_tmp=$pending_file.tmp.$$
+rm -f "$decision_file" >/dev/null 2>&1 || exit 0
+
+created=$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null) || exit 0
+
+if ! printf '%s' "$payload" | jq \
+    --arg tool "$tool_name" \
+    --arg session_id "$session_id" \
+    --arg cwd "$cwd" \
+    --arg created "$created" \
+    '
+    def capped: .[0:4000];
+    def path: (.tool_input.file_path // .tool_input.notebook_path // "");
+    {
+        schema: 1,
+        sessionId: $session_id,
+        tool: $tool,
+        cwd: $cwd,
+        created: $created,
+        summary: (
+            if $tool == "Bash" then "Bash " + ((.tool_input.command // "") | gsub("[\\r\\n]+"; " ") | capped)
+            elif $tool == "Write" then "Write " + path
+            else "Edit " + path
+            end
+        ),
+        bash: (
+            if $tool == "Bash" then {command: ((.tool_input.command // "") | capped)}
+            else null
+            end
+        ),
+        edit: (
+            if $tool == "Edit" or $tool == "NotebookEdit" then {
+                file: path,
+                old: ((.tool_input.old_string // "") | capped),
+                new: ((.tool_input.new_string // .tool_input.new_source // "") | capped)
+            }
+            else null
+            end
+        ),
+        write: (
+            if $tool == "Write" then {
+                file: path,
+                content: ((.tool_input.content // "") | capped)
+            }
+            else null
+            end
+        )
+    }
+    ' > "$pending_tmp" 2>/dev/null
+then
+    rm -f "$pending_tmp" >/dev/null 2>&1
+    exit 0
+fi
+
+mv -f "$pending_tmp" "$pending_file" >/dev/null 2>&1 || {
+    rm -f "$pending_tmp" >/dev/null 2>&1
+    exit 0
+}
+
+# 79 quarter-second sleeps leave enough margin for filesystem/JSON work while
+# preserving the hard 20-second upper bound.
+poll_count=0
+while [ "$poll_count" -lt 79 ]; do
+    if [ -f "$decision_file" ]; then
+        decision=$(jq -r 'if type == "object" then .decision // empty else empty end' "$decision_file" 2>/dev/null) || {
+            remove_decision
+            abort_hook
+        }
+        scope=$(jq -r 'if type == "object" then .scope // empty else empty end' "$decision_file" 2>/dev/null) || {
+            remove_decision
+            abort_hook
+        }
+
+        case $decision:$scope in
+            allow:once|allow:session|deny:once|deny:session) ;;
+            *)
+                remove_decision
+                abort_hook
+                ;;
+        esac
+
+        if [ "$decision" = allow ] && [ "$scope" = session ]; then
+            printf '%s\n' "$tool_class" >> "$session_allow_file" 2>/dev/null || {
+                remove_decision
+                abort_hook
+            }
+        fi
+
+        remove_pending
+        remove_decision
+        if [ "$decision" = allow ]; then
+            printf '%s\n' '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"allow","permissionDecisionReason":"Approved from Vibenotch"}}'
+        else
+            printf '%s\n' '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"deny","permissionDecisionReason":"Denied from Vibenotch"}}'
+        fi
+        exit 0
+    fi
+
+    sleep 0.25 >/dev/null 2>&1 || abort_hook
+    poll_count=$((poll_count + 1))
+done
+
+remove_pending
+exit 0
