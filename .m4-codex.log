diff --git a/Sources/Vibenotch/App/VibenotchApp.swift b/Sources/Vibenotch/App/VibenotchApp.swift
index d4cbcd0c07834cdfdb10f9bf7145f5ad570eb5bc..fd3dcc22cef97a07d4dc4b5c4177f23f4d6da30e
