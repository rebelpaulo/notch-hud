+    func elapsed(at now: Date) -> String {
+        let seconds = max(0, now.timeIntervalSince(startedAt ?? updatedAt))
+
+        if seconds < 60 {
+            return "<1m"
+        }
+        if seconds < 3_600 {
+            return "\(Int(seconds / 60))m"
+        }
+        if seconds < 86_400 {
+            return "\(Int(seconds / 3_600))h"
+        }
+        return "\(Int(seconds / 86_400))d"
+    }
