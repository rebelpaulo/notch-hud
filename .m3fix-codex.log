+            .font(.system(size: 9, weight: .medium, design: .monospaced))
+            .foregroundStyle(tint)
+            .lineLimit(1)
+            .padding(.horizontal, 6)
+            .padding(.vertical, 3)
+            .background(.white.opacity(0.06))
+            .clipShape(.capsule)
     }
 }

