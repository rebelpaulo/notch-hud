   151	    private var approvalsAreEnabled: Bool {
   152	        guard let configURL = environment?.configURL,
   153	              let data = try? Data(contentsOf: configURL),
   154	              let rawObject = try? JSONSerialization.jsonObject(with: data),
   155	              let object = rawObject as? [String: Any]
   156	        else {
   157	            return false
   158	        }
   159	        return object["approvals"] as? Bool == true
   160	    }
   161	
   162	    private func writeApprovalsEnabled(_ enabled: Bool) -> Bool {
   163	        guard let configURL = environment?.configURL else { return false }
   164	
   165	        do {
   166	            var config: [String: Any] = [:]
   167	            if FileManager.default.fileExists(atPath: configURL.path) {
   168	                let data = try Data(contentsOf: configURL)
   169	                guard let existing = try JSONSerialization.jsonObject(with: data) as? [String: Any]
   170	                else {
   171	                    throw CocoaError(.fileReadCorruptFile)
   172	                }
   173	                config = existing
   174	            }
   175	
   176	            config["approvals"] = enabled
   177	            var data = try JSONSerialization.data(
   178	                withJSONObject: config,
   179	                options: [.prettyPrinted, .sortedKeys]
   180	            )
   181	            data.append(0x0A)
   182	            try data.write(to: configURL, options: [.atomic])
   183	            try FileManager.default.setAttributes(
   184	                [.posixPermissions: NSNumber(value: 0o600)],
   185	                ofItemAtPath: configURL.path
   186	            )
   187	            return true
   188	        } catch {
   189	            NSLog(
   190	                "Vibenotch could not update %@: %@",
   191	                configURL.path,
   192	                error.localizedDescription
   193	            )
   194	            return false
   195	        }
   196	    }
   197	}
