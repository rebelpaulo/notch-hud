+            }
+        }
+
+        localEventMonitor = NSEvent.addLocalMonitorForEvents(
+            matching: [.leftMouseDown, .keyDown]
+        ) { [weak self] event in
+            guard let self else { return event }
+
+            if event.type == .keyDown, event.keyCode == 53, self.isExpanded {
+                self.collapse(reason: .manual)
+                return nil
+            }
