   119	        pendingStore.dismiss(sessionID: sessionID)
   120	        store.markPendingApprovals(sessionIDs: Set(pendingStore.approvals.map(\.sessionId)))
   121	        handlePendingTransition(previouslyHadPending: previouslyHadPending)
   122	    }
   123	
   124	    private func handlePendingTransition(previouslyHadPending: Bool) {
   125	        if pendingStore.hasPending {
   126	            pendingAutoExpandActive = true
   127	            expand(reason: .pending)
   128	            return
   129	        }
   130	
   131	        guard previouslyHadPending || pendingAutoExpandActive else { return }
   132	        pendingAutoExpandActive = false
   133	        if !containsExpandedContent(at: NSEvent.mouseLocation) {
   134	            collapse(reason: .pending)
   135	        }
   136	    }
   137	
   138	    func expand(reason: ExpansionReason) {
   139	        HoverDiag.log(
   140	            "expand(reason: \(reason.rawValue)) isExpanded=\(isExpanded) "
   141	                + "selectedScreen=\(selectedScreen != nil) notchedHUD=\(notchedHUD != nil)"
   142	        )
   143	        guard !isExpanded, let screen = selectedScreen else { return }
   144	        guard notchedHUD != nil || floatingPeek != nil else { return }
   145	
   146	        isExpanded = true
   147	        expansionReason = reason
   148	        startWatchdog()
   149	
   150	        transitionGeneration += 1
   151	        let generation = transitionGeneration
   152	        transitionTask?.cancel()
   153	        showInteractivePanel()
   154	
   155	        if let notchedHUD {
   156	            configurePassThroughWindow(notchedHUD.windowController?.window)
   157	            transitionTask = Task { [weak self, weak notchedHUD] in
   158	                guard let self, let notchedHUD else { return }
   159	                await notchedHUD.expand(on: screen)
   160	                guard self.transitionGeneration == generation, self.isExpanded else { return }
   161	                self.configurePassThroughWindow(notchedHUD.windowController?.window)
   162	                self.showInteractivePanel()
   163	            }
   164	            return
   165	        }
   166	
   167	        guard let floatingPeek else { return }
   168	        configurePassThroughWindow(floatingPeek.windowController?.window)
   169	        transitionTask = Task { [weak self, weak floatingPeek] in
   170	            guard let self, let floatingPeek else { return }
   171	            await floatingPeek.hide()
   172	            guard self.transitionGeneration == generation, self.isExpanded else { return }
   173	            self.showInteractivePanel()
   174	        }
   175	    }
   176	
   177	    func collapse(reason: ExpansionReason) {
   178	        if reason == .hover, pendingAutoExpandActive, pendingStore.hasPending {
   179	            HoverDiag.log("collapse(reason: hover) ignored while a pending card is showing")
   180	            return
   181	        }
   182	        guard isExpanded else { return }
   183	
   184	        HoverDiag.log("collapse(reason: \(reason.rawValue))")
   185	        isExpanded = false
   186	        expansionReason = nil
   187	        watchdogTask?.cancel()
   188	        watchdogTask = nil
   189	        interactivePanel?.orderOut(nil)
   190	
   191	        transitionGeneration += 1
   192	        let generation = transitionGeneration
   193	        transitionTask?.cancel()
   194	        guard let screen = selectedScreen else { return }
   195	
   196	        if let notchedHUD {
   197	            configurePassThroughWindow(notchedHUD.windowController?.window)
   198	            transitionTask = Task { [weak self, weak notchedHUD] in
   199	                guard let self, let notchedHUD else { return }
   200	                await notchedHUD.compact(on: screen)
   201	                guard self.transitionGeneration == generation, !self.isExpanded else { return }
   202	                self.configurePassThroughWindow(notchedHUD.windowController?.window)
   203	            }
   204	            return
   205	        }
   206	
   207	        guard let floatingPeek else { return }
   208	        transitionTask = Task { [weak self, weak floatingPeek] in
   209	            guard let self, let floatingPeek else { return }
   210	            await floatingPeek.expand(on: screen)
   211	            guard self.transitionGeneration == generation, !self.isExpanded else { return }
   212	            self.configurePassThroughWindow(floatingPeek.windowController?.window)
   213	        }
   214	    }
   215	
   216	    func containsExpandedContent(at point: NSPoint) -> Bool {
   217	        guard isExpanded, let panel = interactivePanel, panel.isVisible else { return false }
   218	        return panel.frame.contains(point)
   219	    }
   220	
   221	    private func preferredScreen() -> NSScreen? {
   222	        NSScreen.screens.first(where: { $0.safeAreaInsets.top > 0 }) ?? NSScreen.screens.first
   223	    }
   224	
   225	    private func installNotchedHUD(on screen: NSScreen, generation: Int) async {
   226	        let store = store
   227	        let pendingStore = pendingStore
   228	        let notch = NotchedHUD(
   229	            hoverBehavior: [],
   230	            style: .notch,
   231	            expanded: { EmptyView() },
   232	            compactLeading: { NotchPeekView(store: store, pendingStore: pendingStore) },
   233	            compactTrailing: { NotchPeekTrailingView(store: store) }
   234	        )
   235	        notch.transitionConfiguration.skipIntermediateHides = true
   236	        notchedHUD = notch
   237	
   238	        await notch.compact(on: screen)
   239	        guard transitionGeneration == generation, !isExpanded else { return }
   240	        configurePassThroughWindow(notch.windowController?.window)
   241	    }
   242	
   243	    private func installFloatingHUD(on screen: NSScreen, generation: Int) async {
   244	        let store = store
   245	        let pendingStore = pendingStore
   246	        let peek = FloatingPeek(
   247	            hoverBehavior: [],
   248	            style: .floating,
   249	            expanded: { NotchFloatingPeekView(store: store, pendingStore: pendingStore) }
   250	        )
   251	        floatingPeek = peek
   252	
   253	        await peek.expand(on: screen)
   254	        guard transitionGeneration == generation, !isExpanded else { return }
   255	        configurePassThroughWindow(peek.windowController?.window)
   256	    }
