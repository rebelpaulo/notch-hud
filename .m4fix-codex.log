   131	    @objc
   132	    private func togglePauseApprovals(_ sender: NSMenuItem) {
   133	        let shouldPause = sender.state != .on
   134	        guard writeApprovalsEnabled(!shouldPause) else { return }
   135	        sender.state = shouldPause ? .on : .off
   136	        if shouldPause {
   137	            windowManager?.collapse(reason: .manual)
   138	        }
   139	    }
