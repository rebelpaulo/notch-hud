   258	    private func installInteractivePanel() {
   259	        removeInteractivePanel()
   260	
   261	        let store = store
   262	        let pendingStore = pendingStore
   263	        let focusDispatcher = focusDispatcher
   264	        let decisionWriter = decisionWriter
   265	        let rootView = NotchPanelView(
   266	            store: store,
   267	            pendingStore: pendingStore,
   268	            focusDispatcher: focusDispatcher,
   269	            decisionWriter: decisionWriter,
   270	            onApprovalDismiss: { [weak self] sessionID in
   271	                self?.approvalDidResolve(sessionID: sessionID)
   272	            },
   273	            onSizeChange: { [weak self] size in
   274	                self?.updateRenderedPanelSize(size)
   275	            }
   276	        )
   277	        let hostingView = NSHostingView(rootView: rootView)
   278	        hostingView.autoresizingMask = [.width, .height]
   279	
   280	        let panel = InteractiveNotchPanel(
   281	            contentRect: .zero,
   282	            styleMask: [.borderless, .nonactivatingPanel],
   283	            backing: .buffered,
   284	            defer: false
   285	        )
   286	        panel.contentView = hostingView
   287	        panel.isReleasedWhenClosed = false
   288	        panel.isOpaque = false
   289	        panel.backgroundColor = .clear
   290	        panel.hasShadow = true
   291	        panel.hidesOnDeactivate = false
   292	        panel.becomesKeyOnlyIfNeeded = false
   293	        panel.ignoresMouseEvents = false
   294	        panel.level = .statusBar
   295	        panel.collectionBehavior = [
   296	            .canJoinAllSpaces,
   297	            .fullScreenAuxiliary,
   298	            .stationary
   299	        ]
   300	        panel.onEscape = { [weak self] in
   301	            self?.collapse(reason: .manual)
   302	        }
   303	
   304	        interactivePanel = panel
   305	        panelHostingView = hostingView
   306	        hostingView.layoutSubtreeIfNeeded()
   307	        let fittingSize = hostingView.fittingSize
   308	        if fittingSize.width > 0, fittingSize.height > 0 {
   309	            updateRenderedPanelSize(fittingSize)
   310	        }
   311	    }
   312	
   313	    private func showInteractivePanel() {
   314	        guard isExpanded, let panel = interactivePanel else { return }
   315	
   316	        if renderedPanelSize == nil, let hostingView = panelHostingView {
   317	            hostingView.layoutSubtreeIfNeeded()
   318	            let fittingSize = hostingView.fittingSize
   319	            if fittingSize.width > 0, fittingSize.height > 0 {
   320	                updateRenderedPanelSize(fittingSize)
   321	            }
   322	        }
   323	
   324	        guard renderedPanelSize != nil else {
   325	            // Never make an unmeasured (and potentially oversized) panel interactive.
   326	            return
   327	        }
   328	        positionInteractivePanel()
   329	        panel.makeKeyAndOrderFront(nil)
   330	    }
   331	
   332	    private func updateRenderedPanelSize(_ size: CGSize) {
   333	        guard size.width > 0, size.height > 0 else { return }
   334	        renderedPanelSize = CGSize(
   335	            width: ceil(min(size.width, 720)),
   336	            height: ceil(min(size.height, 560))
   337	        )
   338	        positionInteractivePanel()
   339	        if isExpanded, interactivePanel?.isVisible != true {
   340	            showInteractivePanel()
   341	        }
   342	    }
   343	
   344	    private func positionInteractivePanel() {
   345	        guard
   346	            let panel = interactivePanel,
   347	            let screen = selectedScreen,
   348	            let panelSize = renderedPanelSize
   349	        else {
   350	            return
   351	        }
   352	
   353	        let notchBandHeight = max(
   354	            screen.safeAreaInsets.top,
   355	            screen.frame.maxY - screen.visibleFrame.maxY
   356	        )
   357	        let frame = NSRect(
   358	            x: screen.frame.midX - (panelSize.width / 2),
   359	            y: screen.frame.maxY - notchBandHeight - panelSize.height,
   360	            width: panelSize.width,
   361	            height: panelSize.height
   362	        )
   363	        panel.setFrame(frame, display: panel.isVisible)
   364	    }
   365	
   366	    private func removeInteractivePanel() {
   367	        interactivePanel?.onEscape = nil
   368	        interactivePanel?.orderOut(nil)
   369	        interactivePanel?.close()
   370	        interactivePanel = nil
   371	        panelHostingView = nil
   372	    }
   373	
   374	    private func configurePassThroughWindow(_ window: NSWindow?) {
   375	        guard let window else { return }
   376	        window.ignoresMouseEvents = true
   377	        window.level = .statusBar
   378	        window.collectionBehavior.formUnion([
   379	            .canJoinAllSpaces,
   380	            .fullScreenAuxiliary,
   381	            .stationary
   382	        ])
   383	    }
   384	
   385	    private func installInteractionMonitors() {
   386	        guard globalMouseDownMonitor == nil, localEventMonitor == nil else { return }
   387	
   388	        globalMouseDownMonitor = NSEvent.addGlobalMonitorForEvents(matching: .leftMouseDown) {
   389	            [weak self] _ in
   390	            Task { @MainActor [weak self] in
   391	                self?.handleLeftMouseDown(at: NSEvent.mouseLocation)
   392	            }
   393	        }
   394	
   395	        localEventMonitor = NSEvent.addLocalMonitorForEvents(
   396	            matching: [.leftMouseDown, .keyDown]
   397	        ) { [weak self] event in
   398	            guard let self else { return event }
   399	
   400	            if event.type == .keyDown, event.keyCode == 53, self.isExpanded {
   401	                self.collapse(reason: .manual)
   402	                return nil
   403	            }
   404	            if event.type == .leftMouseDown {
   405	                self.handleLeftMouseDown(at: NSEvent.mouseLocation)
   406	            }
   407	            return event
   408	        }
   409	    }
   410	
   411	    private func removeInteractionMonitors() {
   412	        if let globalMouseDownMonitor {
   413	            NSEvent.removeMonitor(globalMouseDownMonitor)
   414	            self.globalMouseDownMonitor = nil
   415	        }
   416	        if let localEventMonitor {
   417	            NSEvent.removeMonitor(localEventMonitor)
   418	            self.localEventMonitor = nil
   419	        }
   420	    }
   421	
   422	    private func handleLeftMouseDown(at point: NSPoint) {
   423	        guard isExpanded, !containsExpandedContent(at: point) else { return }
   424	        collapse(reason: .manual)
   425	    }
   426	
   427	    private func startWatchdog() {
   428	        watchdogTask?.cancel()
   429	        watchdogTask = Task { @MainActor [weak self] in
   430	            var lastPointerInsideTime = ProcessInfo.processInfo.systemUptime
   431	
   432	            while !Task.isCancelled {
   433	                do {
   434	                    try await Task.sleep(for: .seconds(5))
   435	                } catch {
   436	                    return
   437	                }
   438	                guard let self, self.isExpanded else { return }
   439	
   440	                let now = ProcessInfo.processInfo.systemUptime
   441	                if self.containsExpandedContent(at: NSEvent.mouseLocation) {
   442	                    lastPointerInsideTime = now
   443	                } else if now - lastPointerInsideTime >= 120 {
   444	                    NSLog(
   445	                        "Vibenotch watchdog force-collapsed a panel left expanded "
   446	                            + "for 120 seconds without the pointer inside."
   447	                    )
   448	                    self.collapse(reason: .manual)
   449	                    return
   450	                }
   451	            }
   452	        }
   453	    }
   454	
   455	    private func resetExpansionState(reason: ExpansionReason) {
   456	        if isExpanded {
   457	            HoverDiag.log("resetExpansionState(reason: \(reason.rawValue))")
   458	        }
   459	        isExpanded = false
   460	        expansionReason = nil
   461	        watchdogTask?.cancel()
   462	        watchdogTask = nil
   463	        interactivePanel?.orderOut(nil)
   464	    }
   465	
   466	    private func hideEveryNotch() async {
   467	        if let notchedHUD {
   468	            await notchedHUD.hide()
   469	        }
   470	        if let floatingPeek {
   471	            await floatingPeek.hide()
   472	        }
   473	    }
   474	
   475	    private func clearNotches() {
   476	        removeInteractivePanel()
   477	        notchedHUD = nil
   478	        floatingPeek = nil
   479	    }
   480	}
